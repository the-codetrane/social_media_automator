<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Social Media Automator" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Social Media Automator">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900 antialiased">
    <% if authenticated? %>
      <%= render "shared/nav" %>
    <% end %>
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <% if notice.present? %>
        <div class="mb-4 rounded-md bg-green-50 border border-green-200 p-4 flex items-start justify-between gap-3">
          <p class="text-sm font-medium text-green-800"><%= notice %></p>
          <button type="button" onclick="this.closest('div').remove()"
                  class="flex-shrink-0 text-green-500 hover:text-green-700 transition-colors leading-none text-lg"
                  aria-label="Dismiss">&times;</button>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="mb-4 rounded-md bg-red-50 border border-red-200 p-4 flex items-start justify-between gap-3">
          <p class="text-sm font-medium text-red-800"><%= alert %></p>
          <button type="button" onclick="this.closest('div').remove()"
                  class="flex-shrink-0 text-red-400 hover:text-red-600 transition-colors leading-none text-lg"
                  aria-label="Dismiss">&times;</button>
        </div>
      <% end %>
      <%= yield %>
    </main>
    <%# Platform app reviewers look for reachable Terms/Privacy links, so keep
        these in the global footer rather than only on the legal pages. %>
    <footer class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 border-t border-gray-200 text-xs text-gray-400">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <span>&copy; <%= Date.current.year %> Cain &amp; Co.</span>
        <%= link_to "Terms of Service", tos_path, class: "hover:text-gray-600 transition-colors" %>
        <%= link_to "Privacy Policy", privacy_path, class: "hover:text-gray-600 transition-colors" %>
      </div>
    </footer>
  </body>
</html>
