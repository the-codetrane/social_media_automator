<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Social Media Automator" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Social Media Automator">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# The same Cain & Co. logo is used here, on the site itself and as the app
        icon in the Meta/Google/TikTok developer portals — reviewers check that
        they match, so regenerate all of them together from public/app-icon-1024.png. %>
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16">
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-surface-subtle text-body text-sm antialiased">
    <% if authenticated? %>
      <%= render "shared/nav" %>
    <% end %>
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <% if notice.present? %>
        <%= ui_alert notice, variant: :success, dismissible: true, class: "mb-4" %>
      <% end %>
      <% if alert.present? %>
        <%= ui_alert alert, variant: :danger, dismissible: true, class: "mb-4" %>
      <% end %>
      <%= yield %>
    </main>
    <%# Platform app reviewers look for reachable Terms/Privacy links, so keep
        these in the global footer rather than only on the legal pages. %>
    <footer class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 border-t border-gray-200 text-xs text-gray-400">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <span>&copy; <%= Date.current.year %> Cain &amp; Co.</span>
        <%= link_to "Terms of Service", tos_path, class: "hover:text-gray-600 transition-colors" %>
        <%= link_to "Privacy Policy", privacy_path, class: "hover:text-gray-600 transition-colors" %>
      </div>
    </footer>
    <%# data-turbo-confirm opens this dialog instead of the browser confirm(). See application.js. %>
    <%= ui_confirm_dialog %>
  </body>
</html>
