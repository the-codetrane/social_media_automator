<% content_for :title, "Connected Drives" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Connected Drives</h1>
    <p class="text-sm text-gray-500 mt-1"><%= @connected_drives.size %> record<%= "s" if @connected_drives.size != 1 %></p>
  </div>
</div>

<% if @connected_drives.empty? %>
  <div class="text-center py-20 text-gray-400">No connected drives found.</div>
<% else %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @connected_drives.each do |drive| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 flex flex-col gap-4">

        <%# Header %>
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <p class="font-semibold text-gray-900 truncate"><%= drive.name %></p>
            <p class="text-xs text-gray-500 mt-0.5">
              Owner: <span class="font-medium"><%= drive.user&.name || "—" %></span>
            </p>
          </div>
          <span class="shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 capitalize">
            <%= drive.provider.humanize %>
          </span>
        </div>

        <%# Sync status badge %>
        <div class="flex flex-wrap gap-2">
          <% if drive.token_expired? %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700">
              🔒 Token Expired
            </span>
          <% else %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">
              ✓ Token Valid
            </span>
          <% end %>
          <% if drive.synced_recently? %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-50 text-green-700">
              ↻ Recently Synced
            </span>
          <% end %>
        </div>

        <%# Metadata grid %>
        <dl class="grid grid-cols-1 gap-y-2 text-xs">
          <div>
            <dt class="text-gray-400 uppercase tracking-wide">Folder ID</dt>
            <dd class="text-gray-700 font-mono truncate"><%= drive.folder_id %></dd>
          </div>
          <% if drive.account_email.present? %>
            <div>
              <dt class="text-gray-400 uppercase tracking-wide">Account Email</dt>
              <dd class="text-gray-700 truncate"><%= drive.account_email %></dd>
            </div>
          <% end %>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <dt class="text-gray-400 uppercase tracking-wide">Sync Every</dt>
              <dd class="text-gray-700"><%= drive.sync_interval_minutes %> min</dd>
            </div>
            <div>
              <dt class="text-gray-400 uppercase tracking-wide">Assets</dt>
              <dd class="text-gray-700 font-semibold"><%= drive.media_assets.size %></dd>
            </div>
          </div>
          <div>
            <dt class="text-gray-400 uppercase tracking-wide">Last Synced</dt>
            <dd class="text-gray-700">
              <%= drive.last_synced_at ? drive.last_synced_at.strftime("%b %-d, %Y %H:%M") : "Never" %>
            </dd>
          </div>
          <% if drive.token_expires_at.present? %>
            <div>
              <dt class="text-gray-400 uppercase tracking-wide">Token Expires</dt>
              <dd class="<%= drive.token_expired? ? 'text-red-600 font-semibold' : 'text-gray-700' %>">
                <%= drive.token_expires_at.strftime("%b %-d, %Y %H:%M") %>
              </dd>
            </div>
          <% end %>
        </dl>

        <p class="text-xs text-gray-400 border-t border-gray-100 pt-3 mt-auto">
          Created <%= drive.created_at.strftime("%b %-d, %Y") %>
        </p>
      </div>
    <% end %>
  </div>
<% end %>

