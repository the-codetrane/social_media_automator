<% content_for :title, @user.name %>

<div class="max-w-3xl mx-auto">
  <div class="flex items-start gap-3 mb-6">
    <%# TODO(L4): ui_page_header back: %>
    <%= link_to users_path, aria: { label: "Back to users" }, class: "mt-2 text-body-muted hover:text-body transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    <% end %>
    <div class="flex-1 min-w-0">
      <%= ui_page_header title: @user.name do |header| %>
        <% header.with_actions do %>
          <%= ui_button href: edit_user_path(@user), variant: :primary do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
            Edit
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= ui_card body: false do %>
    <div class="p-6">
      <div class="flex items-center gap-4 mb-6">
        <%= ui_avatar name: @user.name, variant: :primary, class: "!size-16 !text-xl" %>
        <div class="min-w-0">
          <p class="text-xl font-semibold text-body"><%= @user.name %></p>
          <p class="text-sm text-body-muted break-all"><%= @user.email_address %></p>
        </div>
      </div>

      <div class="flex flex-wrap gap-2 mb-6">
        <% if @user.instagram_connected? %>
          <% if @user.instagram_token_expired? %>
            <%= ui_badge "Token Expired", variant: :danger, pill: true %>
          <% elsif @user.instagram_token_expiring? %>
            <%= ui_badge "Token Expiring", variant: :warning, pill: true %>
          <% else %>
            <%= ui_badge "Instagram Connected", variant: :success, pill: true %>
          <% end %>
        <% else %>
          <%= ui_badge "Not Connected", variant: :danger, pill: true %>
        <% end %>
      </div>

      <%= ui_stats columns: 2, label: "User summary" do |stats| %>
        <% stats.with_stat(label: "Planned Posts", value: @user.planned_posts.size) %>
        <% stats.with_stat(label: "Joined", value: @user.created_at.strftime("%B %-d, %Y"), class: "[&_dd]:!text-xl") %>
      <% end %>
    </div>

    <% if @user.instagram_user_id.present? || @user.instagram_token_expires_at.present? %>
      <div class="border-t border-border px-6 py-2">
        <%= ui_accordion do |accordion| %>
          <% accordion.with_item(title: "Additional Details", open: true) do %>
            <%= ui_description_list do |dl| %>
              <% if @user.instagram_user_id.present? %>
                <% dl.with_item(term: "Instagram User ID") { tag.span(@user.instagram_user_id, class: "font-mono break-all") } %>
              <% end %>
              <% if @user.instagram_page_id.present? %>
                <% dl.with_item(term: "Instagram Page ID") { tag.span(@user.instagram_page_id, class: "font-mono break-all") } %>
              <% end %>
              <% if @user.instagram_token_expires_at.present? %>
                <% dl.with_item(term: "Token Expires At", description: @user.instagram_token_expires_at.strftime("%B %-d, %Y at %H:%M")) %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
