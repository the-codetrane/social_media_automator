<% content_for :title, "Users" %>

<div class="mb-6">
  <%= ui_page_header title: "Users", subtitle: "#{@users.size} record#{"s" if @users.size != 1}" %>
</div>

<% if @users.empty? %>
  <%= ui_empty_state title: "No users found." %>
<% else %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @users.each do |user| %>
      <%= link_to user_path(user), class: "block rounded-ui-lg hover:shadow-md transition-shadow duration-200" do %>
        <%= ui_card class: "h-full" do |card| %>
          <div class="flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <%= ui_avatar name: user.name, variant: :primary %>
              <div class="min-w-0">
                <p class="font-semibold text-body truncate"><%= user.name %></p>
                <p class="text-xs text-body-muted truncate"><%= user.email_address %></p>
              </div>
            </div>

            <div class="flex flex-wrap gap-2">
              <% if user.instagram_connected? %>
                <% if user.instagram_token_expired? %>
                  <%= ui_badge "Token Expired", variant: :danger, pill: true %>
                <% elsif user.instagram_token_expiring? %>
                  <%= ui_badge "Token Expiring", variant: :warning, pill: true %>
                <% else %>
                  <%= ui_badge "Instagram Connected", variant: :success, pill: true %>
                <% end %>
              <% else %>
                <%= ui_badge "Not Connected", variant: :danger, pill: true %>
              <% end %>
            </div>

            <%= ui_description_list layout: :inline, dividers: false, class: "text-sm" do |dl| %>
              <% if user.instagram_user_id.present? %>
                <% dl.with_item(term: "Instagram ID") { tag.span(user.instagram_user_id, class: "font-mono break-all") } %>
              <% end %>
              <% if user.instagram_token_expires_at.present? %>
                <% dl.with_item(term: "Token Expires", description: user.instagram_token_expires_at.strftime("%b %-d, %Y %H:%M")) %>
              <% end %>
              <% dl.with_item(term: "Posts", description: user.planned_posts.size) %>
            <% end %>
          </div>
          <% card.with_footer(class: "text-xs text-body-muted") { "Joined #{user.created_at.strftime("%b %-d, %Y")}" } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
