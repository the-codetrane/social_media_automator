<% content_for :title, "Edit #{@user.name}" %>

<div class="max-w-2xl mx-auto">
  <%= ui_page_header title: "Edit User", back: {href: user_path(@user), label: "User"}, class: "mb-6" %>

  <%= ui_card do %>
    <%= ui_form_with model: @user, class: "space-y-6" do |f| %>
      <%= f.error_summary title: "#{pluralize(@user.errors.count, "error")} prohibited this user from being saved:" %>

      <%= f.text_field :name %>
      <%= f.email_field :email_address, label: "Email Address" %>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-border">
        <%= ui_button "Cancel", href: user_path(@user), outline: true, variant: :secondary %>
        <%= f.submit "Save Changes", variant: :primary %>
      </div>
    <% end %>
  <% end %>
</div>
