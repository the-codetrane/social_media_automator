<% content_for :title, "Edit #{@user.name}" %>

<div class="max-w-2xl mx-auto">
  <div class="flex items-start gap-3 mb-6">
    <%# TODO(L4): ui_page_header back: %>
    <%= link_to user_path(@user), aria: { label: "Back to #{@user.name}" }, class: "mt-2 text-body-muted hover:text-body transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    <% end %>
    <%= ui_page_header title: "Edit User", class: "flex-1 min-w-0" %>
  </div>

  <%= ui_card do %>
    <%= ui_form_with model: @user, class: "space-y-6" do |f| %>
      <%= f.error_summary title: "#{pluralize(@user.errors.count, "error")} prohibited this user from being saved:" %>

      <%= f.text_field :name %>
      <%= f.email_field :email_address, label: "Email Address" %>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-border">
        <%= ui_button "Cancel", href: user_path(@user), outline: true, variant: :secondary %>
        <%= f.submit "Save Changes", variant: :primary %>
      </div>
    <% end %>
  <% end %>
</div>
