<%= form_with model: known_person, class: "space-y-6" do |form| %>
  <% if known_person.errors.any? %>
    <div class="px-4 py-3 rounded-lg bg-red-50 text-red-800 text-sm">
      <p class="font-medium mb-2"><%= pluralize(known_person.errors.count, "error") %> prevented this from being saved:</p>
      <ul class="list-disc list-inside">
        <% known_person.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_field :name, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors", placeholder: "e.g. Mike Cain" %>
  </div>

  <%# Reference image — file upload preferred, URL as fallback %>
  <div class="space-y-4 p-4 bg-gray-50 rounded-lg border border-gray-200">
    <p class="text-sm font-medium text-gray-700">Reference Photo</p>

    <div>
      <%= form.label :reference_image, "Upload a photo", class: "block text-sm text-gray-600 mb-2" %>
      <%= form.file_field :reference_image, accept: "image/*", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 transition-colors" %>

      <% if known_person.reference_image.attached? %>
        <div class="mt-3 flex items-center gap-3">
          <%= image_tag known_person.reference_image, class: "w-16 h-16 object-cover rounded-lg border border-gray-200", alt: known_person.name %>
          <p class="text-xs text-gray-500">Current photo — upload a new one to replace it.</p>
        </div>
      <% end %>
    </div>

    <div class="relative flex items-center">
      <div class="flex-grow border-t border-gray-300"></div>
      <span class="mx-3 text-xs text-gray-400 uppercase tracking-wide">or</span>
      <div class="flex-grow border-t border-gray-300"></div>
    </div>

    <div>
      <%= form.label :reference_image_url, "Use an existing CDN URL", class: "block text-sm text-gray-600 mb-2" %>
      <%= form.url_field :reference_image_url, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors text-sm", placeholder: "https://..." %>
      <p class="mt-1 text-xs text-gray-400">Paste a URL from your media library if you already have a good reference shot.</p>
    </div>
  </div>

  <div>
    <%= form.label :notes, "Notes (optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_area :notes, rows: 2, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors resize-none text-sm", placeholder: "e.g. Lead vocalist, appears in most show photos" %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to "Cancel", known_people_path, class: "px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors" %>
    <%= form.submit known_person.new_record? ? "Add Person" : "Save Changes", class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
