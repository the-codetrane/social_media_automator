<%= ui_form_with model: known_person, multipart: true, class: "space-y-6" do |f| %>
  <%= f.error_summary title: "#{pluralize(known_person.errors.count, "error")} prevented this from being saved:" %>

  <%= f.text_field :name, placeholder: "e.g. Mike Cain" %>

  <%# Reference image: file upload preferred, URL as fallback %>
  <%# TODO(L?): radio_cards that reveal one of the two fields (needs a reveal behaviour) %>
  <fieldset class="space-y-4 p-4 bg-surface-subtle rounded-ui border border-border">
    <legend class="text-sm font-medium text-body px-1">Reference Photo</legend>

    <div>
      <%= f.file_upload :reference_image, label: "Upload a photo", accept: "image/*" %>

      <% if known_person.reference_image.attached? %>
        <div class="mt-3 flex items-center gap-3">
          <%= image_tag known_person.reference_image, class: "w-16 h-16 object-cover rounded-ui border border-border", alt: known_person.name %>
          <p class="text-xs text-body-muted">Current photo. Upload a new one to replace it.</p>
        </div>
      <% end %>
    </div>

    <%= f.url_field :reference_image_url, label: "Or use an existing CDN URL", placeholder: "https://...",
        hint: "Paste a URL from your media library if you already have a good reference shot." %>
  </fieldset>

  <%= f.text_area :notes, label: "Notes (optional)", rows: 2, placeholder: "e.g. Lead vocalist, appears in most show photos" %>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-border">
    <%= ui_button "Cancel", href: known_people_path, outline: true, variant: :secondary %>
    <%= f.submit known_person.new_record? ? "Add Person" : "Save Changes", variant: :primary %>
  </div>
<% end %>
