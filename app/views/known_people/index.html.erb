<% content_for :title, "Known People" %>

<div class="mb-6">
  <%= ui_page_header title: "Known People", subtitle: "Reference photos used by the AI to identify people in your media." do |header| %>
    <% header.with_actions do %>
      <%= ui_button href: new_known_person_path, variant: :primary do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Add Person
      <% end %>
    <% end %>
  <% end %>
</div>

<% if @known_people.empty? %>
  <%= ui_empty_state title: "No known people yet.", text: "Add reference photos so the AI can recognize band members and key subjects in your media." do |empty| %>
    <% empty.with_icon do %>
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
      </svg>
    <% end %>
    <% empty.with_action do %>
      <%= ui_button "Add Your First Person", href: new_known_person_path, variant: :primary %>
    <% end %>
  <% end %>
<% else %>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
    <% @known_people.each do |person| %>
      <%= link_to known_person_path(person), class: "block rounded-ui hover:shadow-md transition-shadow duration-200" do %>
        <%= ui_card body: false, class: "h-full overflow-hidden" do %>
          <div class="aspect-square bg-surface-muted overflow-hidden">
            <% if person.public_url? %>
              <%= image_tag person.public_url, class: "w-full h-full object-cover", alt: person.name %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center">
                <%= ui_avatar name: person.name, variant: :primary, class: "!size-16 !text-xl" %>
              </div>
            <% end %>
          </div>
          <div class="p-3">
            <p class="font-semibold text-body truncate"><%= person.name %></p>
            <% if person.notes.present? %>
              <p class="text-xs text-body-muted mt-0.5 line-clamp-2"><%= person.notes %></p>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
