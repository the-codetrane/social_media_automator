<% content_for :title, "Add Known Person" %>

<div class="max-w-2xl mx-auto">
  <div class="flex items-center gap-4 mb-6">
    <%= link_to known_people_path, class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900">Add Known Person</h1>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <%= render "form", known_person: @known_person %>
  </div>
</div>
