<% content_for :title, "Add Known Person" %>

<div class="max-w-2xl mx-auto">
  <div class="flex items-start gap-3 mb-6">
    <%# TODO(L4): ui_page_header back: %>
    <%= link_to known_people_path, aria: { label: "Back to known people" }, class: "mt-2 text-body-muted hover:text-body transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    <% end %>
    <%= ui_page_header title: "Add Known Person", class: "flex-1 min-w-0" %>
  </div>

  <%= ui_card do %>
    <%= render "form", known_person: @known_person %>
  <% end %>
</div>
