<% content_for :title, @known_person.name %>

<div class="max-w-2xl mx-auto">
  <%= ui_page_header title: @known_person.name,
                   back: {href: known_people_path, label: "Known people"}, class: "mb-6" do |header| %>
    <% header.with_actions do %>
      <%= button_to known_person_path(@known_person), method: :delete,
          data: { turbo_confirm: "Remove #{@known_person.name}? This cannot be undone." },
          class: "inline-flex items-center justify-center gap-2 px-4 py-2 min-h-11 bg-surface border border-danger text-danger text-sm font-medium rounded-ui hover:bg-danger/10 transition-colors cursor-pointer" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        Remove
      <% end %>
      <%= ui_button href: edit_known_person_path(@known_person), variant: :primary do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Edit
      <% end %>
    <% end %>
  <% end %>

  <%= ui_card do %>
    <div class="flex flex-col sm:flex-row gap-6">
      <div class="shrink-0">
        <% if @known_person.public_url? %>
          <%= image_tag @known_person.public_url, class: "w-32 h-32 object-cover rounded-ui-lg border border-border", alt: @known_person.name %>
        <% else %>
          <div class="w-32 h-32 rounded-ui-lg border border-border bg-surface-muted flex items-center justify-center">
            <%= ui_avatar name: @known_person.name, variant: :primary, class: "!size-16 !text-xl" %>
          </div>
        <% end %>
      </div>

      <div class="flex-1 min-w-0">
        <% if @known_person.notes.present? %>
          <p class="text-body-muted text-sm leading-relaxed mb-4"><%= @known_person.notes %></p>
        <% end %>

        <%= ui_description_list layout: :inline, class: "text-sm" do |dl| %>
          <% dl.with_item(term: "Photo source") do %>
            <% if @known_person.reference_image.attached? %>
              Uploaded file
            <% elsif @known_person.reference_image_url.present? %>
              CDN URL
            <% else %>
              None
            <% end %>
          <% end %>
          <% dl.with_item(term: "Added", description: @known_person.created_at.strftime("%B %-d, %Y")) %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
