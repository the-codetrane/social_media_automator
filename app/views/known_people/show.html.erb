<% content_for :title, @known_person.name %>

<div class="max-w-2xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-4">
      <%= link_to known_people_path, class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      <% end %>
      <h1 class="text-2xl font-bold text-gray-900"><%= @known_person.name %></h1>
    </div>
    <div class="flex items-center gap-2">
      <%= button_to known_person_path(@known_person), method: :delete,
          data: { turbo_confirm: "Remove #{@known_person.name}? This cannot be undone." },
          class: "inline-flex items-center gap-2 px-4 py-2 bg-white border border-red-300 text-red-600 text-sm font-medium rounded-lg hover:bg-red-50 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        Remove
      <% end %>
      <%= link_to edit_known_person_path(@known_person), class: "inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Edit
      <% end %>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="mb-6 px-4 py-3 rounded-lg bg-green-50 text-green-800 text-sm">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="p-6 flex gap-6">
      <%# Reference photo %>
      <div class="shrink-0">
        <% if @known_person.public_url? %>
          <%= image_tag @known_person.public_url, class: "w-32 h-32 object-cover rounded-xl border border-gray-200", alt: @known_person.name %>
        <% else %>
          <div class="w-32 h-32 rounded-xl border border-gray-200 bg-gray-100 flex items-center justify-center text-gray-300">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
        <% end %>
      </div>

      <div class="flex-1 min-w-0">
        <% if @known_person.notes.present? %>
          <p class="text-gray-600 text-sm leading-relaxed mb-4"><%= @known_person.notes %></p>
        <% end %>

        <dl class="grid grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-xs text-gray-400 uppercase tracking-wide mb-1">Photo source</dt>
            <dd class="text-gray-700">
              <% if @known_person.reference_image.attached? %>
                Uploaded file
              <% elsif @known_person.reference_image_url.present? %>
                CDN URL
              <% else %>
                None
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-xs text-gray-400 uppercase tracking-wide mb-1">Added</dt>
            <dd class="text-gray-700"><%= @known_person.created_at.strftime("%B %-d, %Y") %></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</div>
