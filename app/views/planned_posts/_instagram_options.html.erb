<%# Instagram-only publishing options: co-authors and Reels audio. %>
<div class="pt-4 border-t border-border space-y-6">
  <p class="text-xs text-body-muted uppercase tracking-wide">Instagram Options</p>

  <%# ------------------------------------------------------------------ %>
  <%# Collaborators                                                       %>
  <%# ------------------------------------------------------------------ %>
  <%= ui_combobox name: "planned_post[collaborators][]",
        multiple: true,
        max: Instagram::PublishOptions::MAX_COLLABORATORS,
        allow_free_text: true,
        values: collaborators,
        label: "Collaborators",
        placeholder: "Search or type a username…",
        src: collaborator_search_planned_post_path(planned_post),
        frame_id: "collaborator-suggestions",
        input: { id: "collaborator_input" } %>
  <p class="-mt-4 text-xs text-body-muted">
    Co-authors see the post on their own profile once they accept. Suggestions come from accounts
    you have tagged before — type any username and press Enter to add a new one. Not supported on Stories.
  </p>

  <%# ------------------------------------------------------------------ %>
  <%# Reels audio                                                         %>
  <%# ------------------------------------------------------------------ %>
  <%# TODO(L7): f.combobox :audio_id once the search endpoint renders ui_combobox_option frames. %>
  <div data-controller="audio-select"
       data-audio-select-url-value="<%= audio_search_planned_post_path(planned_post) %>"
       data-audio-select-initial-value="<%= (selected_audio || {}).to_json %>">

    <label for="audio_search_input" class="block text-sm font-medium text-body mb-2">Audio</label>

    <%# Currently attached track %>
    <div data-audio-select-target="selected" class="hidden mb-2"></div>

    <div data-audio-select-target="picker">
      <div class="flex gap-2 mb-2">
        <input type="text"
               id="audio_search_input"
               data-audio-select-target="input"
               data-action="input->audio-select#search"
               placeholder="Search audio, or leave blank for trending…"
               autocomplete="off"
               class="flex-1 px-3 py-2 border border-border rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-primary transition-colors">

        <select data-audio-select-target="type"
                data-action="change->audio-select#search"
                class="px-3 py-2 border border-border rounded-lg text-sm bg-surface focus:ring-2 focus:ring-primary focus:border-primary transition-colors">
          <option value="music">Music</option>
          <option value="original_sound">Original sounds</option>
        </select>
      </div>

      <div data-audio-select-target="results"
           class="hidden border border-border rounded-lg divide-y divide-border-subtle max-h-64 overflow-y-auto"></div>
    </div>

    <div data-audio-select-target="hiddenInputs"></div>

    <p class="mt-1 text-xs text-body-muted">
      Applies to video posts, which publish as Reels. Only audio Meta has licensed for third-party
      use is listed, so the catalogue is smaller than the Instagram app's.
    </p>
  </div>
</div>
