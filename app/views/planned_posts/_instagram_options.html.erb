<%# Instagram-only publishing options: co-authors and Reels audio. %>
<div class="pt-4 border-t border-gray-200 space-y-6">
  <p class="text-xs text-gray-400 uppercase tracking-wide">Instagram Options</p>

  <%# ------------------------------------------------------------------ %>
  <%# Collaborators                                                       %>
  <%# ------------------------------------------------------------------ %>
  <div data-controller="collaborator-select"
       data-collaborator-select-url-value="<%= collaborator_search_planned_post_path(planned_post) %>"
       data-collaborator-select-max-value="<%= Instagram::PublishOptions::MAX_COLLABORATORS %>"
       data-collaborator-select-initial-value="<%= collaborators.to_json %>">

    <div class="flex items-baseline justify-between mb-2">
      <label for="collaborator_input" class="block text-sm font-medium text-gray-700">Collaborators</label>
      <span class="text-xs text-gray-400" data-collaborator-select-target="counter"></span>
    </div>

    <%# Chips + text entry share one bordered box so they read as one field %>
    <div class="relative">
      <div class="flex flex-wrap items-center gap-1.5 w-full px-2 py-1.5 border border-gray-300 rounded-lg bg-white focus-within:ring-2 focus-within:ring-indigo-500 focus-within:border-indigo-500 transition-colors">
        <span data-collaborator-select-target="chips" class="contents"></span>
        <input type="text"
               id="collaborator_input"
               data-collaborator-select-target="input"
               data-action="input->collaborator-select#search focus->collaborator-select#search keydown->collaborator-select#keydown blur->collaborator-select#hideSuggestions"
               placeholder="Search or type a username…"
               autocomplete="off"
               class="flex-1 min-w-[10rem] px-2 py-1 text-sm border-0 focus:ring-0 focus:outline-none">
      </div>

      <%# Suggestion dropdown %>
      <div data-collaborator-select-target="suggestions"
           class="hidden absolute z-10 left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-lg overflow-hidden max-h-56 overflow-y-auto"></div>
    </div>

    <div data-collaborator-select-target="hiddenInputs"></div>

    <p class="mt-1 text-xs text-gray-500">
      Co-authors see the post on their own profile once they accept. Suggestions come from accounts
      you have tagged before — type any username to add a new one. Not supported on Stories.
    </p>
  </div>

  <%# ------------------------------------------------------------------ %>
  <%# Reels audio                                                         %>
  <%# ------------------------------------------------------------------ %>
  <div data-controller="audio-select"
       data-audio-select-url-value="<%= audio_search_planned_post_path(planned_post) %>"
       data-audio-select-initial-value="<%= (selected_audio || {}).to_json %>">

    <label for="audio_search_input" class="block text-sm font-medium text-gray-700 mb-2">Audio</label>

    <%# Currently attached track %>
    <div data-audio-select-target="selected" class="hidden mb-2"></div>

    <div data-audio-select-target="picker">
      <div class="flex gap-2 mb-2">
        <input type="text"
               id="audio_search_input"
               data-audio-select-target="input"
               data-action="input->audio-select#search"
               placeholder="Search audio, or leave blank for trending…"
               autocomplete="off"
               class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors">

        <select data-audio-select-target="type"
                data-action="change->audio-select#search"
                class="px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors">
          <option value="music">Music</option>
          <option value="original_sound">Original sounds</option>
        </select>
      </div>

      <div data-audio-select-target="results"
           class="hidden border border-gray-200 rounded-lg divide-y divide-gray-100 max-h-64 overflow-y-auto"></div>
    </div>

    <div data-audio-select-target="hiddenInputs"></div>

    <p class="mt-1 text-xs text-gray-500">
      Applies to video posts, which publish as Reels. Only audio Meta has licensed for third-party
      use is listed, so the catalogue is smaller than the Instagram app's.
    </p>
  </div>
</div>
