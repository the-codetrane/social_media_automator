<% content_for :title, "Planned Post" %>


<div class="max-w-3xl mx-auto">
  <%= ui_page_header title: "Planned Post", back: {href: planned_posts_path, label: "Planned posts"}, class: "mb-6" do |header| %>
    <% header.with_pager(prev: {href: @prev_post && planned_post_path(@prev_post), label: "Previous post"},
                         next: {href: @next_post && planned_post_path(@next_post), label: "Next post"}) %>
    <% header.with_actions do %>
      <%# Only Instagram and Facebook have a PostVerifier; offering Re-verify for
          any other platform just queues a job that raises. %>
      <% can_verify = (@planned_post.instagram? || @planned_post.facebook?) && @planned_post.published? && @planned_post.external_post_id.present? %>
      <% if (@planned_post.instagram? || @planned_post.facebook? || @planned_post.youtube? || @planned_post.tiktok?) && !@planned_post.published? && !@planned_post.canceled? %>
        <%= form_with url: publish_planned_post_path(@planned_post), method: :post, class: "m-0" do %>
          <%= ui_button type: :submit, variant: :primary do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
            Publish to <%= platform_display_name(@planned_post.platform) %>
          <% end %>
        <% end %>
      <% end %>
      <%= ui_button href: edit_planned_post_path(@planned_post), variant: :primary, outline: true do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Edit
      <% end %>
      <%= ui_dropdown(placement: "bottom-end") do |menu| %>
        <% menu.with_trigger(variant: :secondary, outline: true, aria: { label: "More actions" }) { "More" } %>
        <% if can_verify %>
          <% menu.with_item("Re-verify", href: verify_planned_post_path(@planned_post), method: :post) %>
        <% end %>
        <% menu.with_item("Delete", href: planned_post_path(@planned_post), method: :delete,
            data: { turbo_confirm: "Are you sure you want to delete this planned post? This cannot be undone." }) %>
      <% end %>
    <% end %>
  <% end %>

  <div class="bg-surface rounded-xl shadow-sm border border-border overflow-hidden">
    <%# Main info section %>
    <div class="p-6">
      <%# Badges row %>
      <div class="flex flex-wrap gap-2 mb-6">
        <%= render PlatformBadgeComponent.new(platform: @planned_post.platform, class: "text-sm") %>
        <%= render StatusBadgeComponent.new(status: @planned_post.status, class: "text-sm") %>
      </div>

      <%# Why a publish failed, so diagnosing it doesn't mean reading server logs. %>
      <% if @planned_post.failed? && @planned_post.failure_reason.present? %>
        <%= ui_alert variant: :danger, class: "mb-6" do %>
          <p class="text-xs font-semibold mb-1">Publish failed</p>
          <p class="text-sm"><%= @planned_post.failure_reason %></p>
          <% unless @planned_post.platform_connected? %>
            <p class="text-sm mt-2">
              <%= platform_display_name(@planned_post.platform) %> is not connected.
              Connect the account in Admin, then publish again.
            </p>
          <% end %>
        <% end %>
      <% end %>

      <%# Media Preview %>
      <% if @carousel_assets&.any? %>
        <div class="mb-6">
          <p class="text-xs text-body-muted mb-2">Media (<%= @carousel_assets.size %> items)</p>
          <div class="relative w-full sm:max-w-md rounded-lg overflow-hidden bg-surface-subtle" data-controller="carousel">
            <% @carousel_assets.each_with_index do |asset, i| %>
              <div data-carousel-target="slide" class="<%= i > 0 ? 'hidden' : '' %>">
                <% if asset.public_url? %>
                  <% if asset.video? %>
                    <video controls class="w-full h-auto" preload="metadata">
                      <source src="<%= asset.public_url %>" type="<%= asset.mime_type || 'video/mp4' %>">
                      Your browser does not support the video tag.
                    </video>
                  <% else %>
                    <%= image_tag asset.public_url,
                        class: "w-full h-auto object-contain",
                        alt: decode_name(asset.external_name.presence || "Media #{i + 1}") %>
                  <% end %>
                <% else %>
                  <div class="flex items-center justify-center h-48 text-body-muted text-sm">No preview</div>
                <% end %>
              </div>
            <% end %>

            <% if @carousel_assets.size > 1 %>
              <button type="button"
                class="absolute left-2 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white rounded-full w-8 h-8 flex items-center justify-center transition-colors"
                data-action="click->carousel#prev">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
              </button>
              <button type="button"
                class="absolute right-2 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white rounded-full w-8 h-8 flex items-center justify-center transition-colors"
                data-action="click->carousel#next">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
              <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5">
                <% @carousel_assets.each_with_index do |_, i| %>
                  <button type="button"
                    class="w-2 h-2 rounded-full transition-colors <%= i == 0 ? 'bg-white' : 'bg-white/50' %>"
                    data-carousel-target="dot"
                    data-index="<%= i %>"
                    data-action="click->carousel#goTo">
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% elsif @planned_post.media_asset.public_url? %>
        <div class="mb-6">
          <p class="text-xs text-body-muted mb-2">Media</p>
          <div class="rounded-lg overflow-hidden bg-surface-subtle w-full sm:max-w-md">
            <% if @planned_post.media_asset.image? %>
              <%= image_tag @planned_post.media_asset.public_url,
                  class: "w-full h-auto object-contain",
                  alt: decode_name(@planned_post.media_asset.external_name.presence || "Media asset") %>
            <% elsif @planned_post.media_asset.video? %>
              <video
                controls
                class="w-full h-auto"
                preload="metadata"
              >
                <source src="<%= @planned_post.media_asset.public_url %>" type="<%= @planned_post.media_asset.mime_type || 'video/mp4' %>">
                Your browser does not support the video tag.
              </video>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Caption %>
      <% if @planned_post.caption.present? %>
        <div class="mb-6">
          <p class="text-xs text-body-muted mb-2">Caption</p>
          <p class="text-body leading-relaxed whitespace-pre-wrap"><%= @planned_post.caption %></p>
        </div>
      <% end %>

      <%# Hashtags %>
      <% if @planned_post.hashtags.present? %>
        <div class="mb-6">
          <p class="text-xs text-body-muted mb-2">Hashtags</p>
          <p class="text-primary"><%= @planned_post.hashtags %></p>
        </div>
      <% end %>

      <%# Main metadata %>
      <%= ui_description_list layout: :inline do |dl| %>
        <% if @planned_post.scheduled_at.present? %>
          <% dl.with_item(term: "Scheduled At", description: @planned_post.scheduled_at.strftime("%B %-d, %Y at %H:%M")) %>
        <% end %>
        <% if @planned_post.published_at.present? %>
          <% dl.with_item(term: "Published At") do %>
            <span class="text-success"><%= @planned_post.published_at.strftime("%B %-d, %Y at %H:%M") %></span>
          <% end %>
        <% end %>
        <% if (permalink = @planned_post.platform_payload&.dig("permalink")).present? %>
          <% dl.with_item(term: "Live Post") do %>
            <%= link_to "View on #{platform_display_name(@planned_post.platform)}", permalink,
                target: "_blank", rel: "noopener",
                class: "text-primary hover:text-primary-emphasis hover:underline" %>
          <% end %>
        <% end %>
        <%# Nothing else on this page distinguishes a story from a single feed post. %>
        <% if @planned_post.story? %>
          <% dl.with_item(term: "Story", description: story_status_label(@planned_post)) %>
        <% end %>
        <% dl.with_item(term: "Media Asset") do %>
          <%= link_to decode_name(@planned_post.media_asset.external_name.presence || @planned_post.media_asset.external_id),
              media_asset_path(@planned_post.media_asset),
              class: "text-primary hover:text-primary-emphasis hover:underline" %>
        <% end %>
        <% dl.with_item(term: "Owner") do %>
          <%= link_to @planned_post.user.name,
              user_path(@planned_post.user),
              class: "text-primary hover:text-primary-emphasis hover:underline" %>
        <% end %>
        <% if @planned_post.social_template.present? %>
          <% dl.with_item(term: "Template") do %>
            <%= link_to @planned_post.social_template.name,
                social_template_path(@planned_post.social_template),
                class: "text-primary hover:text-primary-emphasis hover:underline" %>
          <% end %>
        <% end %>
        <% if (collaborators = @planned_post.platform_payload&.dig("collaborators")).present? %>
          <% dl.with_item(term: "Collaborators") do %>
            <span class="flex flex-wrap gap-1.5">
              <% collaborators.each do |username| %>
                <span class="inline-flex items-center px-2 py-0.5 bg-primary-subtle text-primary-emphasis text-sm rounded-md">@<%= username %></span>
              <% end %>
            </span>
          <% end %>
        <% end %>
        <% if (audio_id = @planned_post.platform_payload&.dig("audio_id")).present? %>
          <% dl.with_item(term: "Audio") do %>
            <%= @planned_post.platform_payload["audio_title"].presence || audio_id %>
            <% if (artist = @planned_post.platform_payload["audio_artist"]).present? %>
              <span class="block text-sm text-body-muted"><%= artist %></span>
            <% end %>
          <% end %>
        <% end %>
        <% dl.with_item(term: "Created", description: @planned_post.created_at.strftime("%B %-d, %Y")) %>
      <% end %>
    </div>

    <%# Additional details: <details>-based accordion, no JS %>
    <% if @planned_post.external_post_id.present? || @planned_post.platform_payload.present? %>
      <div class="border-t border-border p-6">
        <%= ui_accordion do |accordion| %>
          <% accordion.with_item(title: "Additional Details") do %>
            <%= ui_description_list do |dl| %>
              <% if @planned_post.external_post_id.present? %>
                <% dl.with_item(term: "External Post ID") do %>
                  <span class="font-mono break-all"><%= @planned_post.external_post_id %></span>
                <% end %>
              <% end %>
              <% if @planned_post.platform_payload.present? %>
                <% dl.with_item(term: "Platform Payload") do %>
                  <div class="font-mono text-xs bg-surface-subtle rounded-lg p-4 overflow-x-auto">
                    <pre><%= JSON.pretty_generate(@planned_post.platform_payload) %></pre>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
