<% content_for :title, "Planned Post" %>


<div class="max-w-3xl mx-auto">
  <%# Header with back link and edit CTA %>
  <div class="flex flex-wrap items-start justify-between gap-3 mb-6">
    <div class="flex items-center gap-3">
      <%= link_to planned_posts_path, class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      <% end %>
      <h1 class="text-xl sm:text-2xl font-bold text-gray-900">Planned Post</h1>
      <div class="flex items-center gap-1 ml-2">
        <%= @prev_post \
          ? link_to(planned_post_path(@prev_post), title: "Previous post", class: "p-1 rounded text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors") { tag.svg(class: "w-4 h-4", fill: "none", stroke: "currentColor", viewBox: "0 0 24 24") { tag.path(stroke_linecap: "round", stroke_linejoin: "round", stroke_width: "2", d: "M15 19l-7-7 7-7") } }
          : tag.span(class: "p-1 text-gray-200") { tag.svg(class: "w-4 h-4", fill: "none", stroke: "currentColor", viewBox: "0 0 24 24") { tag.path(stroke_linecap: "round", stroke_linejoin: "round", stroke_width: "2", d: "M15 19l-7-7 7-7") } } %>
        <%= @next_post \
          ? link_to(planned_post_path(@next_post), title: "Next post", class: "p-1 rounded text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors") { tag.svg(class: "w-4 h-4", fill: "none", stroke: "currentColor", viewBox: "0 0 24 24") { tag.path(stroke_linecap: "round", stroke_linejoin: "round", stroke_width: "2", d: "M9 5l7 7-7 7") } }
          : tag.span(class: "p-1 text-gray-200") { tag.svg(class: "w-4 h-4", fill: "none", stroke: "currentColor", viewBox: "0 0 24 24") { tag.path(stroke_linecap: "round", stroke_linejoin: "round", stroke_width: "2", d: "M9 5l7 7-7 7") } } %>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <% if @planned_post.published? && @planned_post.external_post_id.present? %>
        <%= button_to verify_planned_post_path(@planned_post), method: :post,
            class: "inline-flex items-center gap-2 px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Re-verify
        <% end %>
      <% end %>
      <% if (@planned_post.instagram? || @planned_post.facebook? || @planned_post.youtube?) && !@planned_post.published? && !@planned_post.canceled? %>
        <%= button_to publish_planned_post_path(@planned_post), method: :post,
            class: "inline-flex items-center gap-2 px-4 py-2 bg-pink-600 text-white text-sm font-medium rounded-lg hover:bg-pink-700 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
          </svg>
          Publish to <%= platform_display_name(@planned_post.platform) %>
        <% end %>
      <% end %>
      <%= link_to edit_planned_post_path(@planned_post), class: "inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Edit
      <% end %>
      <%= button_to planned_post_path(@planned_post), method: :delete,
          data: { turbo_confirm: "Are you sure you want to delete this planned post? This cannot be undone." },
          class: "inline-flex items-center gap-2 px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        Delete
      <% end %>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="mb-6 px-4 py-3 rounded-lg bg-green-50 text-green-800 text-sm">
      <%= flash[:notice] %>
    </div>
  <% end %>
  <% if flash[:alert] %>
    <div class="mb-6 px-4 py-3 rounded-lg bg-red-50 text-red-800 text-sm">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <%# Main info section %>
    <div class="p-6">
      <%# Badges row %>
      <div class="flex flex-wrap gap-2 mb-6">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= platform_color_classes(@planned_post.platform) %>">
          <%= platform_display_name(@planned_post.platform) %>
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= status_color_classes(@planned_post.status) %> capitalize">
          <%= @planned_post.status %>
        </span>
      </div>

      <%# Media Preview %>
      <% if @carousel_assets&.any? %>
        <div class="mb-6">
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-2">Media (<%= @carousel_assets.size %> photos)</p>
          <div class="relative w-full sm:max-w-md rounded-lg overflow-hidden bg-gray-100" data-controller="carousel">
            <% @carousel_assets.each_with_index do |asset, i| %>
              <div data-carousel-target="slide" class="<%= i > 0 ? 'hidden' : '' %>">
                <% if asset.public_url? %>
                  <%= image_tag asset.public_url,
                      class: "w-full h-auto object-contain",
                      alt: decode_name(asset.external_name.presence || "Photo #{i + 1}") %>
                <% else %>
                  <div class="flex items-center justify-center h-48 text-gray-400 text-sm">No preview</div>
                <% end %>
              </div>
            <% end %>

            <% if @carousel_assets.size > 1 %>
              <button type="button"
                class="absolute left-2 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white rounded-full w-8 h-8 flex items-center justify-center transition-colors"
                data-action="click->carousel#prev">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
              </button>
              <button type="button"
                class="absolute right-2 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white rounded-full w-8 h-8 flex items-center justify-center transition-colors"
                data-action="click->carousel#next">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
              <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5">
                <% @carousel_assets.each_with_index do |_, i| %>
                  <button type="button"
                    class="w-2 h-2 rounded-full transition-colors <%= i == 0 ? 'bg-white' : 'bg-white/50' %>"
                    data-carousel-target="dot"
                    data-index="<%= i %>"
                    data-action="click->carousel#goTo">
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% elsif @planned_post.media_asset.public_url? %>
        <div class="mb-6">
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-2">Media</p>
          <div class="rounded-lg overflow-hidden bg-gray-100 w-full sm:max-w-md">
            <% if @planned_post.media_asset.image? %>
              <%= image_tag @planned_post.media_asset.public_url,
                  class: "w-full h-auto object-contain",
                  alt: decode_name(@planned_post.media_asset.external_name.presence || "Media asset") %>
            <% elsif @planned_post.media_asset.video? %>
              <video
                controls
                class="w-full h-auto"
                preload="metadata"
              >
                <source src="<%= @planned_post.media_asset.public_url %>" type="<%= @planned_post.media_asset.mime_type || 'video/mp4' %>">
                Your browser does not support the video tag.
              </video>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Caption %>
      <% if @planned_post.caption.present? %>
        <div class="mb-6">
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-2">Caption</p>
          <p class="text-gray-900 leading-relaxed whitespace-pre-wrap"><%= @planned_post.caption %></p>
        </div>
      <% end %>

      <%# Hashtags %>
      <% if @planned_post.hashtags.present? %>
        <div class="mb-6">
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-2">Hashtags</p>
          <p class="text-indigo-600"><%= @planned_post.hashtags %></p>
        </div>
      <% end %>

      <%# Main metadata %>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <% if @planned_post.scheduled_at.present? %>
          <div>
            <dt class="text-xs text-gray-400 uppercase tracking-wide mb-1">Scheduled At</dt>
            <dd class="text-lg text-gray-900"><%= @planned_post.scheduled_at.strftime("%B %-d, %Y at %H:%M") %></dd>
          </div>
        <% end %>
        <% if @planned_post.published_at.present? %>
          <div>
            <dt class="text-xs text-gray-400 uppercase tracking-wide mb-1">Published At</dt>
            <dd class="text-lg text-green-700"><%= @planned_post.published_at.strftime("%B %-d, %Y at %H:%M") %></dd>
          </div>
        <% end %>
        <% if (permalink = @planned_post.platform_payload&.dig("permalink")).present? %>
          <div>
            <dt class="text-xs text-gray-400 uppercase tracking-wide mb-1">Live Post</dt>
            <dd class="text-lg">
              <%= link_to "View on #{platform_display_name(@planned_post.platform)}", permalink,
                  target: "_blank", rel: "noopener",
                  class: "text-indigo-600 hover:text-indigo-800 hover:underline" %>
            </dd>
          </div>
        <% end %>
        <div>
          <dt class="text-xs text-gray-400 uppercase tracking-wide mb-1">Media Asset</dt>
          <dd class="text-lg text-gray-900">
            <%= link_to decode_name(@planned_post.media_asset.external_name.presence || @planned_post.media_asset.external_id),
                media_asset_path(@planned_post.media_asset),
                class: "text-indigo-600 hover:text-indigo-800 hover:underline" %>
          </dd>
        </div>
        <div>
          <dt class="text-xs text-gray-400 uppercase tracking-wide mb-1">Owner</dt>
          <dd class="text-lg text-gray-900">
            <%= link_to @planned_post.user.name,
                user_path(@planned_post.user),
                class: "text-indigo-600 hover:text-indigo-800 hover:underline" %>
          </dd>
        </div>
        <% if @planned_post.social_template.present? %>
          <div>
            <dt class="text-xs text-gray-400 uppercase tracking-wide mb-1">Template</dt>
            <dd class="text-lg text-gray-900">
              <%= link_to @planned_post.social_template.name,
                  social_template_path(@planned_post.social_template),
                  class: "text-indigo-600 hover:text-indigo-800 hover:underline" %>
            </dd>
          </div>
        <% end %>
        <div>
          <dt class="text-xs text-gray-400 uppercase tracking-wide mb-1">Created</dt>
          <dd class="text-lg text-gray-900"><%= @planned_post.created_at.strftime("%B %-d, %Y") %></dd>
        </div>
      </dl>
    </div>

    <%# Collapsible additional details %>
    <% if @planned_post.external_post_id.present? || @planned_post.platform_payload.present? %>
      <div class="border-t border-gray-200" data-controller="collapse">
        <button
          type="button"
          class="w-full flex items-center justify-between px-6 py-4 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
          data-action="click->collapse#toggle"
        >
          <span>Additional Details</span>
          <svg class="w-5 h-5 text-gray-400 transition-transform duration-200 rotate-180" data-collapse-target="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="px-6 pb-6" data-collapse-target="content">
          <dl class="grid grid-cols-1 gap-4 text-sm">
            <% if @planned_post.external_post_id.present? %>
              <div>
                <dt class="text-gray-400 uppercase tracking-wide text-xs mb-1">External Post ID</dt>
                <dd class="text-gray-700 font-mono break-all"><%= @planned_post.external_post_id %></dd>
              </div>
            <% end %>
            <% if @planned_post.platform_payload.present? %>
              <div>
                <dt class="text-gray-400 uppercase tracking-wide text-xs mb-1">Platform Payload</dt>
                <dd class="text-gray-700 font-mono text-xs bg-gray-50 rounded-lg p-4 overflow-x-auto">
                  <pre><%= JSON.pretty_generate(@planned_post.platform_payload) %></pre>
                </dd>
              </div>
            <% end %>
          </dl>
        </div>
      </div>
    <% end %>
  </div>
</div>

