<% content_for :title, "Edit Planned Post" %>

<%
  status_options = PlannedPost.statuses.keys.map { |s| [s.titleize, s] }
  current_post_type = @planned_post.post_type
%>

<div class="max-w-2xl mx-auto">
  <%# Header with back link %>
  <div class="flex items-center gap-4 mb-6">
    <%= link_to planned_post_path(@planned_post), class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900">Edit Planned Post</h1>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <%= form_with model: @planned_post, class: "space-y-6" do |form| %>
      <% if @planned_post.errors.any? %>
        <div class="px-4 py-3 rounded-lg bg-red-50 text-red-800 text-sm">
          <p class="font-medium mb-2"><%= pluralize(@planned_post.errors.count, "error") %> prohibited this post from being saved:</p>
          <ul class="list-disc list-inside">
            <% @planned_post.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :caption, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_area :caption, rows: 5, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors resize-none", placeholder: "Write your caption here..." %>
      </div>

      <div>
        <%= form.label :hashtags, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :hashtags, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors", placeholder: "#example #hashtags" %>
        <p class="mt-1 text-xs text-gray-500">Space-separated hashtags to include with your post.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.select :status, status_options, {}, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors bg-white" %>
        </div>
        <div>
          <%= form.label :scheduled_at, "Scheduled At", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.datetime_local_field :scheduled_at, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors" %>
        </div>
      </div>

      <%# Post type toggle + media selection %>
      <div data-controller="post-type">
        <p class="block text-sm font-medium text-gray-700 mb-2">Post Type</p>
        <div class="flex gap-4 mb-4">
          <label class="flex items-center gap-2 cursor-pointer">
            <%= form.radio_button :post_type, "single",
                  checked: current_post_type == "single",
                  class: "text-indigo-600 focus:ring-indigo-500",
                  data: { action: "change->post-type#update" } %>
            <span class="text-sm text-gray-700">Single</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <%= form.radio_button :post_type, "carousel",
                  checked: current_post_type == "carousel",
                  class: "text-indigo-600 focus:ring-indigo-500",
                  data: { action: "change->post-type#update" } %>
            <span class="text-sm text-gray-700">Carousel</span>
          </label>
        </div>

        <%# Single media asset section %>
        <div data-post-type-target="singleSection" class="<%= 'hidden' if current_post_type == 'carousel' %>">
          <%= form.label :media_asset_id, "Media Asset", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.collection_select :media_asset_id, @media_assets, :id, ->(a) { CGI.unescape(a.external_name.presence || a.external_id) }, {}, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors bg-white" %>
        </div>

        <%# Carousel media selection section %>
        <div data-post-type-target="carouselSection"
             class="<%= 'hidden' if current_post_type == 'single' %>"
             data-controller="carousel-select"
             data-carousel-select-initial-ids-value="<%= @carousel_asset_ids.to_json %>">

          <p class="block text-sm font-medium text-gray-700 mb-2">Carousel Assets <span class="font-normal text-gray-500">(select 2–10, drag to reorder)</span></p>

          <%# Search %>
          <input type="text"
                 data-carousel-select-target="search"
                 data-action="input->carousel-select#filter"
                 placeholder="Search assets..."
                 class="w-full px-3 py-2 mb-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors">

          <%# Picker: scrollable checkbox list %>
          <div class="border border-gray-200 rounded-lg overflow-y-auto max-h-48 mb-3 divide-y divide-gray-100">
            <% if @media_assets.any? %>
              <% @media_assets.each do |asset| %>
                <%
                  asset_name = CGI.unescape(asset.external_name.presence || asset.external_id)
                  is_checked = @carousel_asset_ids.include?(asset.id)
                %>
                <label data-carousel-select-target="option"
                       class="flex items-center gap-3 px-3 py-2 hover:bg-gray-50 cursor-pointer">
                  <input type="checkbox"
                         data-carousel-select-target="checkbox"
                         data-action="change->carousel-select#toggle"
                         data-name="<%= asset_name %>"
                         value="<%= asset.id %>"
                         <%= "checked" if is_checked %>
                         class="rounded text-indigo-600 focus:ring-indigo-500">
                  <span class="text-sm text-gray-700 truncate"><%= asset_name %></span>
                </label>
              <% end %>
            <% else %>
              <p class="px-3 py-4 text-sm text-gray-400 text-center">No processed media assets available.</p>
            <% end %>
          </div>

          <%# Selected ordered list %>
          <div data-carousel-select-target="selectedList" class="space-y-1 mb-2"></div>

          <%# Hidden inputs for ordered IDs %>
          <div data-carousel-select-target="hiddenInputs"></div>
        </div>
      </div>

      <% if @planned_post.instagram? %>
        <%= render "instagram_options",
              planned_post:   @planned_post,
              collaborators:  @collaborators,
              selected_audio: @selected_audio %>
      <% end %>

      <div>
        <%= form.label :social_template_id, "Social Template", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.collection_select :social_template_id, @social_templates, :id, :name, { include_blank: "— No template —" }, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors bg-white" %>
      </div>

      <%# Read-only fields for reference %>
      <div class="pt-4 border-t border-gray-200">
        <p class="text-xs text-gray-400 uppercase tracking-wide mb-3">Reference Information</p>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-gray-500">Platform</dt>
            <dd class="text-gray-700 capitalize"><%= @planned_post.platform %></dd>
          </div>
          <div>
            <dt class="text-gray-500">Owner</dt>
            <dd class="text-gray-700"><%= @planned_post.user.name %></dd>
          </div>
        </dl>
      </div>

      <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-2 sm:gap-3 pt-4 border-t border-gray-200">
        <%= link_to "Cancel", planned_post_path(@planned_post), class: "w-full sm:w-auto text-center px-4 py-2.5 sm:py-2 text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors border border-gray-300 rounded-lg sm:border-0 sm:rounded-none" %>
        <%= form.submit "Save Changes", class: "w-full sm:w-auto px-4 py-2.5 sm:py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
