<% content_for :title, "Edit Planned Post" %>

<%
  status_options = PlannedPost.statuses.keys.map { |s| [s.titleize, s] }
  current_post_type = @planned_post.post_type
%>

<div class="max-w-2xl mx-auto">
  <%= ui_page_header title: "Edit Planned Post", back: {href: planned_post_path(@planned_post), label: "Planned post"}, class: "mb-6" %>

  <div class="bg-surface rounded-xl shadow-sm border border-border p-6">
    <%= ui_form_with model: @planned_post, class: "space-y-6" do |form| %>
      <%= form.error_summary %>

      <% if @reuse_warnings.any? %>
        <%= ui_alert variant: :warning do %>
          <p class="font-medium mb-1">This post reuses media:</p>
          <ul class="list-disc list-inside">
            <% @reuse_warnings.each do |warning| %>
              <li><%= warning %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <%= form.text_area :caption, rows: 5, placeholder: "Write your caption here..." %>
      <%# No caption max length is available in this view, so no counter: yet. %>

      <%= form.text_field :hashtags, placeholder: "#example #hashtags", hint: "Space-separated hashtags to include with your post." %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <%= form.select :status, status_options %>
        <%= form.datetime_local_field :scheduled_at, label: "Scheduled At" %>
      </div>

      <%# Post type toggle + media selection %>
      <div data-controller="post-type" class="space-y-6">
        <div>
          <%# post_type_controller listens for change events bubbling up from the radios in this fieldset. %>
          <% post_type_choices = [["Single", "single", "One image or video"], ["Carousel", "carousel", "2-10 assets"]] %>
          <%# Instagram and Facebook are the platforms with a Stories publisher. %>
          <% post_type_choices << ["Story", "story", "24-hour story"] if @planned_post.instagram? || @planned_post.facebook? %>
          <%= form.radio_cards :post_type, post_type_choices, label: "Post Type", columns: 3,
                checked: current_post_type, class: "mb-4",
                data: { action: "change->post-type#update" } %>

          <%# Single media asset section — a story picks one asset the same way %>
          <div data-post-type-target="singleSection" class="<%= 'hidden' if current_post_type == 'carousel' %>">
            <%= form.select :media_asset_id, grouped_media_asset_options(@media_assets, @asset_availability, @planned_post.media_asset_id), { label: "Media Asset", hint: "Assets that are archived, already published, or on another scheduled post are listed after the available ones." } %>
          </div>

          <p data-post-type-target="storyNote"
             class="<%= 'hidden' unless current_post_type == 'story' %> mt-3 px-3 py-2 text-xs text-warning-emphasis bg-warning-subtle border border-warning-border rounded-lg">
            Stories show a single image or video for 24 hours. Meta's Stories API accepts no caption,
            hashtags, collaborators or audio — those fields stay on this record but are not sent when
            it publishes, and a published story is not verified afterwards. Use a 9:16 asset
            (1080×1920); video must be 3–60 seconds.
          </p>

          <%# Carousel media selection section %>
          <div data-post-type-target="carouselSection"
               class="<%= 'hidden' unless current_post_type == 'carousel' %>"
               data-controller="carousel-select"
               data-carousel-select-initial-ids-value="<%= @carousel_asset_ids.to_json %>">

            <p class="block text-sm font-medium text-body mb-2">Carousel Assets <span class="font-normal text-body-muted">(select 2–10, drag to reorder)</span></p>

            <%# Search %>
            <input type="text"
                   data-carousel-select-target="search"
                   data-action="input->carousel-select#filter"
                   placeholder="Search assets..."
                   class="w-full px-3 py-2 mb-2 border border-border rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-primary transition-colors">

            <label class="inline-flex items-center gap-2 mb-2 text-xs text-body-muted cursor-pointer">
              <input type="checkbox"
                     data-carousel-select-target="showUsed"
                     data-action="change->carousel-select#filter"
                     class="rounded text-primary focus:ring-primary">
              Show archived, published and scheduled assets
            </label>

            <%# Picker: scrollable checkbox list %>
            <div class="border border-border rounded-lg overflow-y-auto max-h-48 mb-3 divide-y divide-border-subtle">
              <% if @media_assets.any? %>
                <% @media_assets.each do |asset| %>
                  <%
                    asset_name = CGI.unescape(asset.external_name.presence || asset.external_id)
                    is_checked = @carousel_asset_ids.include?(asset.id)
                  %>
                  <% availability = @asset_availability[asset.id] %>
                  <label data-carousel-select-target="option"
                         data-used="<%= availability != "available" %>"
                         class="flex items-center gap-3 px-3 py-2 hover:bg-surface-subtle cursor-pointer <%= "hidden" if availability != "available" && !is_checked %>">
                    <input type="checkbox"
                           data-carousel-select-target="checkbox"
                           data-action="change->carousel-select#toggle"
                           data-name="<%= asset_name %>"
                           value="<%= asset.id %>"
                           <%= "checked" if is_checked %>
                           class="rounded text-primary focus:ring-primary">
                    <span class="text-sm text-body truncate flex-1"><%= asset_name %></span>
                    <%= render "media_assets/availability_badge", availability: availability %>
                  </label>
                <% end %>
              <% else %>
                <p class="px-3 py-4 text-sm text-body-muted text-center">No processed media assets available.</p>
              <% end %>
            </div>

            <%# Selected ordered list %>
            <div data-carousel-select-target="selectedList" class="space-y-1 mb-2"></div>

            <%# Hidden inputs for ordered IDs %>
            <div data-carousel-select-target="hiddenInputs"></div>
          </div>
        </div>

        <% if @planned_post.instagram? %>
          <div data-post-type-target="feedOptions" class="<%= 'hidden' if current_post_type == 'story' %>">
            <%= render "instagram_options",
                  planned_post:   @planned_post,
                  collaborators:  @collaborators,
                  selected_audio: @selected_audio %>
          </div>
        <% end %>
      </div>

      <%= form.select :social_template_id, @social_templates.map { |t| [t.name, t.id] }, { include_blank: "— No template —", label: "Social Template" } %>

      <%# Read-only fields for reference %>
      <div class="pt-4 border-t border-border">
        <p class="text-xs text-body-muted uppercase tracking-wide mb-1">Reference Information</p>
        <%= ui_description_list layout: :inline, dividers: false do |dl| %>
          <% dl.with_item(term: "Platform") do %>
            <span class="capitalize"><%= @planned_post.platform %></span>
          <% end %>
          <% dl.with_item(term: "Owner", description: @planned_post.user.name) %>
        <% end %>
      </div>

      <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-2 sm:gap-3 pt-4 border-t border-border">
        <%= ui_button "Cancel", href: planned_post_path(@planned_post), variant: :secondary, outline: true %>
        <%= form.submit "Save Changes", variant: :primary %>
      </div>
    <% end %>
  </div>
</div>
