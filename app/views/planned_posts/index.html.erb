<% content_for :title, "Planned Posts" %>

<%# One shared form carries the selected ids (post_ids[]) for both bulk actions. The row checkboxes
    and the dialog fields attach to it with the form attribute; each action's submit button picks
    the route (formaction) and the HTTP verb (_method). %>
<% bulk_form_id = "bulk-posts-form" %>
<% platform_variants = { "facebook" => :info, "youtube" => :danger, "tiktok" => :dark } %>
<% status_variants = { "draft" => :secondary, "scheduled" => :primary, "published" => :success, "failed" => :danger } %>
<% any_media = @planned_posts.any? { |post| post.media_asset&.public_url.present? } %>

<div data-controller="cl-bulk-select view-toggle"
     data-view-toggle-storage-key-value="planned_posts_view">

  <%= ui_page_header title: "Planned Posts", subtitle: "#{@pagy.count} record#{"s" if @pagy.count != 1}", class: "mb-6" do |header| %>
    <% header.with_actions do %>
      <%= ui_toggle_group name: "view", type: :radio, style: :segmented, size: :sm, label: "View", legend_visible: false do |group| %>
        <% group.with_option(value: "card", checked: true, icon_only: true, label: "Card view",
                             data: { view_toggle_target: "cardInput", action: "change->view-toggle#select" }) do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
            </svg>
        <% end %>
        <% group.with_option(value: "table", icon_only: true, label: "Table view",
                             data: { view_toggle_target: "tableInput", action: "change->view-toggle#select" }) do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M3 14h18M10 6h11M10 18h11M3 6h.01M3 18h.01" />
            </svg>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%# Filter bar: every change submits the GET form into the list frame %>
  <%= form_with url: planned_posts_path,
                method: :get,
                data: { turbo_frame: "planned-posts-list", turbo_action: "advance" },
                class: "flex flex-col sm:flex-row sm:flex-wrap sm:items-start gap-4 sm:gap-6 mb-4" do %>
    <%= ui_toggle_group name: "platforms", type: :checkbox, style: :pills, size: :sm, label: "Platform", autosubmit: true do |group| %>
      <% %w[instagram facebook youtube tiktok].each do |platform| %>
        <% group.with_option(platform == "tiktok" ? "TikTok" : (platform == "youtube" ? "YouTube" : platform.capitalize),
                             value: platform, checked: @platforms.include?(platform), variant: platform_variants[platform]) %>
      <% end %>
    <% end %>

    <%# Status is a radio group: exactly one is always selected %>
    <%= ui_toggle_group name: "status", type: :radio, style: :segmented, size: :sm, label: "Status", autosubmit: true do |group| %>
      <% %w[draft scheduled published failed].each do |status| %>
        <% group.with_option(status.capitalize, value: status, checked: @status == status, variant: status_variants[status]) %>
      <% end %>
    <% end %>
  <% end %>

  <%= form_with url: bulk_destroy_planned_posts_path, method: :post, id: bulk_form_id do %><% end %>

  <%# Bulk action bar: hidden until posts are selected %>
  <%= ui_bulk_action_bar label: "Post actions", noun: "post", noun_plural: "posts", position: :top, class: "mb-4" do |bar| %>
    <% bar.with_action do %>
      <%= ui_modal title: "Reschedule Posts", size: :sm, centered: true do |modal| %>
        <% modal.with_trigger(variant: :primary, outline: true, size: :sm) { "Reschedule" } %>
        <p class="text-sm text-body-muted mb-4">Shift each selected post's scheduled time forward by:</p>
        <div class="flex gap-3">
          <%= ui_form_field(label: "Amount", control_id: "bulk-reschedule-amount", class: "w-24") do |field| %>
            <%= number_field_tag "amount", 1, min: 1, max: 10, form: bulk_form_id, **field.control_options %>
          <% end %>
          <%= ui_form_field(label: "Unit", control_id: "bulk-reschedule-unit", class: "flex-1") do |field| %>
            <%= select_tag "unit", options_for_select([ [ "Hours", "hours" ], [ "Days", "days" ], [ "Weeks", "weeks" ] ], "days"),
                           form: bulk_form_id, **field.control_options(kind: :select) %>
          <% end %>
        </div>
        <% modal.with_footer do %>
          <%= ui_button "Cancel", outline: true, variant: :secondary, data: { action: "cl-dialog#close" } %>
          <%= ui_button "Reschedule", type: :submit, variant: :primary, form: bulk_form_id,
                        formaction: bulk_reschedule_planned_posts_path, name: "_method", value: "patch" %>
        <% end %>
      <% end %>
    <% end %>

    <% bar.with_action do %>
      <%= ui_modal title: "Delete Posts", size: :sm, centered: true do |modal| %>
        <% modal.with_trigger(variant: :danger, outline: true, size: :sm) { "Delete" } %>
        <p class="text-sm text-body-muted">
          Permanently delete
          <strong class="text-body"><span data-cl-bulk-select-target="count">0</span> post(s)</strong>?
          This cannot be undone.
        </p>
        <% modal.with_footer do %>
          <%= ui_button "Cancel", outline: true, variant: :secondary, data: { action: "cl-dialog#close" } %>
          <%= ui_button "Delete", type: :submit, variant: :danger, form: bulk_form_id,
                        formaction: bulk_destroy_planned_posts_path, name: "_method", value: "delete" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%# Post grid %>
  <%= turbo_frame_tag "planned-posts-list",
        data: { action: "turbo:frame-render->view-toggle#applyView" } do %>
    <% if @planned_posts.empty? %>
      <%= ui_empty_state title: "No planned posts found." %>
    <% else %>

      <%# ── Card view ──────────────────────────────────────────────────────── %>
      <div data-view-toggle-target="cardView">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @planned_posts.each do |post| %>
            <% snippet = post.caption.present? ? post.caption.truncate(40) : "post #{post.id}" %>
            <div class="relative rounded-ui has-checked:ring-2 has-checked:ring-primary has-checked:ring-offset-1">
              <%# Selection checkbox: a sibling of the card so a click doesn't open it %>
              <span class="absolute top-3 left-3 z-10 flex rounded bg-surface p-1 shadow-sm">
                <%= ui_selection_checkbox label: "Select post: #{snippet}", value: post.id, name: "post_ids[]", form: bulk_form_id %>
              </span>

              <%# The link sits inside a turbo frame, so send it to the whole page %>
              <%= ui_card href: planned_post_path(post), link_label: "Planned post: #{snippet}",
                          class: "h-full", data: { turbo_frame: "_top" } do |card| %>
                <% if any_media %>
                  <% card.with_media(aspect: :video) do %>
                    <% thumb_url = post.media_asset&.public_url %>
                    <% if thumb_url.present? && post.media_asset.image? %>
                      <%= image_tag thumb_url, loading: "lazy", alt: "" %>
                    <% elsif thumb_url.present? && post.media_asset.video? %>
                      <div class="flex size-full items-center justify-center bg-dark">
                        <svg class="w-10 h-10 text-white/60" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      </div>
                    <% else %>
                      <div class="flex size-full items-center justify-center bg-surface-subtle text-body-muted">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                      </div>
                    <% end %>
                  <% end %>
                <% end %>

                <div class="flex flex-col gap-4">
                  <div class="flex flex-wrap gap-2">
                    <%= render PlatformBadgeComponent.new(platform: post.platform) %>
                    <%= render StatusBadgeComponent.new(status: post.status) %>
                  </div>

                  <% if post.caption.present? %>
                    <p class="text-sm text-body line-clamp-3 leading-relaxed"><%= post.caption.truncate(160) %></p>
                  <% else %>
                    <p class="text-sm text-body-muted italic">No caption</p>
                  <% end %>

                  <% if post.hashtags.present? %>
                    <p class="text-xs text-primary truncate"><%= post.hashtags %></p>
                  <% end %>

                  <%= ui_description_list dividers: false, class: "text-sm" do |dl| %>
                    <% if post.scheduled_at.present? %>
                      <% dl.with_item(term: "Scheduled At", description: post.scheduled_at.strftime("%b %-d, %Y %H:%M"), class: "py-1") %>
                    <% end %>
                    <% if post.published_at.present? %>
                      <% dl.with_item(term: "Published At", description: post.published_at.strftime("%b %-d, %Y %H:%M"), class: "py-1") %>
                    <% end %>
                    <% dl.with_item(term: "Media Asset", class: "py-1") do %>
                      <span class="block truncate"><%= decode_name(post.media_asset&.external_name.presence || post.media_asset&.external_id) || "—" %></span>
                    <% end %>
                    <% dl.with_item(term: "Owner", description: post.user&.name || "—", class: "py-1") %>
                    <% if post.social_template.present? %>
                      <% dl.with_item(term: "Template", class: "py-1") do %>
                        <span class="block truncate"><%= post.social_template.name %></span>
                      <% end %>
                    <% end %>
                    <% if post.external_post_id.present? %>
                      <% dl.with_item(term: "External Post ID", class: "py-1") do %>
                        <span class="block truncate font-mono"><%= post.external_post_id %></span>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
                <% card.with_footer(class: "text-xs text-body-muted") do %>
                  Created <%= post.created_at.strftime("%b %-d, %Y") %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%# ── Table view ─────────────────────────────────────────────────────── %>
      <div data-view-toggle-target="tableView" class="hidden">
        <% sort_base = { platforms: @platforms, status: @status } %>
        <% sort_data = { turbo_frame: "planned-posts-list", turbo_action: "advance" } %>
        <% date_col = @status == "published" ? "published_at" : "scheduled_at" %>
        <% sort_href = ->(col) { url_for(sort_base.merge(sort: col, direction: (@sort == col && @direction == "asc") ? "desc" : "asc", page: 1)) } %>
        <% sort_dir = ->(col) { @sort == col ? @direction.to_sym : nil } %>
        <%= ui_table hover: true, responsive: true do |table| %>
          <% table.with_caption(visible: false) { "Planned posts" } %>
          <thead>
            <tr>
              <th class="w-10"><%= ui_select_all_checkbox label: "Select all posts" %></th>
              <%= ui_sort_header "Platform", href: sort_href.call("platform"), direction: sort_dir.call("platform"), link: { data: sort_data } %>
              <%= ui_table_header "Status" %>
              <%= ui_table_header "Caption" %>
              <%= ui_sort_header(@status == "published" ? "Published At" : "Scheduled At", href: sort_href.call(date_col),
                                 direction: sort_dir.call(date_col), class: "whitespace-nowrap", link: { data: sort_data }) %>
              <%= ui_table_header "Owner" %>
              <%= ui_table_header "Media Asset" %>
              <th class="w-10"><span class="sr-only">Open</span></th>
            </tr>
          </thead>
          <tbody>
            <% @planned_posts.each do |post| %>
              <% snippet = post.caption.present? ? post.caption.truncate(40) : "post #{post.id}" %>
              <tr>
                <td>
                  <%# Disabled while hidden so it isn't counted or submitted twice (view_toggle_controller toggles it) %>
                  <%= ui_selection_checkbox label: "Select post: #{snippet}", value: post.id, name: "post_ids[]", form: bulk_form_id, disabled: true %>
                </td>
                <td><%= render PlatformBadgeComponent.new(platform: post.platform) %></td>
                <td><%= render StatusBadgeComponent.new(status: post.status) %></td>
                <td class="max-w-xs">
                  <% if post.caption.present? %>
                    <p class="truncate"><%= post.caption.truncate(80) %></p>
                  <% else %>
                    <p class="text-body-muted italic">No caption</p>
                  <% end %>
                </td>
                <td class="whitespace-nowrap">
                  <% if post.scheduled_at.present? %>
                    <span><%= post.scheduled_at.strftime("%b %-d, %Y %H:%M") %></span>
                  <% elsif post.published_at.present? %>
                    <span class="text-success"><%= post.published_at.strftime("%b %-d, %Y %H:%M") %></span>
                  <% else %>
                    <span class="text-body-muted">—</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap"><%= post.user&.name || "—" %></td>
                <td class="max-w-xs">
                  <span class="truncate block"><%= decode_name(post.media_asset&.external_name.presence || post.media_asset&.external_id) || "—" %></span>
                </td>
                <td>
                  <%= link_to planned_post_path(post), data: { turbo_frame: "_top" }, aria: { label: "Open planned post: #{snippet}" },
                              class: "text-body-muted hover:text-primary transition-colors" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                      </svg>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        <% end %>
      </div>

      <%= ui_pagy @pagy, frame: "planned-posts-list" %>
    <% end %>
  <% end %>
</div>
