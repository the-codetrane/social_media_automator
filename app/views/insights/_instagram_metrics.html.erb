<%
  metrics      = insights[:metrics]
  product_type = insights[:product_type]

  engagement_keys = case product_type
                    when "REELS" then %w[likes comments shares saved]
                    when "STORY" then %w[shares replies]
                    else              %w[likes comments shares saved]
                    end

  engagement_data = engagement_keys.each_with_object({}) do |key, h|
    label = Instagram::InsightsService::METRIC_LABELS.fetch(key, key.humanize)
    h[label] = metrics.fetch(key, 0).to_i
  end
%>

<%# Top stat cards %>
<%
  stat_keys = case product_type
              when "STORY" then %w[reach follows profile_visits]
              else              %w[reach total_interactions profile_visits]
              end
  stat_keys = stat_keys.select { |key| metrics.key?(key) }
%>
<% if stat_keys.any? %>
  <%= ui_stats columns: 4, label: "Headline metrics", class: "mb-6" do |stats| %>
    <% stat_keys.each do |key| %>
      <% stats.with_stat label: Instagram::InsightsService::METRIC_LABELS.fetch(key, key.humanize),
                         value: number_with_delimiter(metrics[key].to_i) %>
    <% end %>
  <% end %>
<% end %>

<%# Engagement breakdown chart %>
<% if engagement_data.values.sum > 0 %>
  <%= ui_card class: "mb-6" do %>
    <h2 class="text-sm font-semibold text-body-muted mb-4">Engagement Breakdown</h2>
    <%= bar_chart engagement_data,
          colors: ["#6366f1"],
          height: "280px",
          library: {
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
          } %>
  <% end %>
<% end %>

<%# Reel-specific watch time metrics %>
<% if product_type == "REELS" && (metrics.key?("ig_reels_avg_watch_time") || metrics.key?("ig_reels_video_view_total_time")) %>
  <%= ui_card class: "mb-6" do %>
    <h2 class="text-sm font-semibold text-body-muted mb-4">Watch Time</h2>
    <%= ui_stats columns: 2, label: "Watch time" do |stats| %>
      <% if metrics.key?("ig_reels_avg_watch_time") %>
        <% stats.with_stat label: "Avg Watch Time", value: "#{(metrics["ig_reels_avg_watch_time"].to_f / 1000).round(1)}s" %>
      <% end %>
      <% if metrics.key?("ig_reels_video_view_total_time") %>
        <% stats.with_stat label: "Total View Time", value: "#{(metrics["ig_reels_video_view_total_time"].to_f / 1000 / 60).round(1)}m" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%# All metrics table %>
<%= ui_card body: false do |card| %>
  <% card.with_header { tag.h2("All Metrics", class: "text-sm font-semibold text-body-muted") } %>
  <%= ui_table hover: true, responsive: true, class: "mb-0" do |table| %>
    <% table.with_caption(visible: false) { "All metrics" } %>
    <thead>
      <tr>
        <%= ui_table_header "Metric" %>
        <%= ui_table_header "Value", class: "text-right" %>
      </tr>
    </thead>
    <tbody>
      <% metrics.each do |key, value| %>
        <tr>
          <td class="text-body-muted"><%= Instagram::InsightsService::METRIC_LABELS.fetch(key, key.humanize) %></td>
          <td class="text-right font-semibold"><%= number_with_delimiter(value.to_i) %></td>
        </tr>
      <% end %>
    </tbody>
  <% end %>
  <% card.with_footer do %>
    <span class="text-xs text-body-muted">Data from Meta Graph API &middot; External ID: <span class="font-mono"><%= post.external_post_id %></span></span>
  <% end %>
<% end %>
