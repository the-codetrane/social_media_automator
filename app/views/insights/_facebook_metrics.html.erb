<%
  metrics    = insights[:metrics]
  media_type = insights[:media_type]

  reaction_data = Facebook::InsightsService::REACTION_KEYS.each_with_object({}) do |key, h|
    label = Facebook::InsightsService::METRIC_LABELS.fetch(key, key.humanize)
    h[label] = metrics.fetch(key, 0).to_i
  end

  total_reactions = reaction_data.values.sum

  impressions_data = {
    "Organic" => metrics.fetch("post_impressions_organic", 0).to_i,
    "Paid"    => metrics.fetch("post_impressions_paid", 0).to_i
  }
%>

<%# Top stat cards %>
<%
  headline = [
    ["post_impressions_unique", "Reach"],
    ["post_impressions",        "Total Impressions"],
    ["post_clicks",             "Post Clicks"]
  ].select { |key, _| metrics.key?(key) }
%>
<% if headline.any? %>
  <%= ui_stats columns: 4, label: "Headline metrics", class: "mb-6" do |stats| %>
    <% headline.each do |key, fallback_label| %>
      <% stats.with_stat label: Facebook::InsightsService::METRIC_LABELS.fetch(key, fallback_label),
                         value: number_with_delimiter(metrics[key].to_i) %>
    <% end %>
  <% end %>
<% end %>

<%# Reactions breakdown %>
<% if total_reactions > 0 %>
  <%= ui_card class: "mb-6" do %>
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-semibold text-body-muted">Reactions</h2>
      <span class="text-sm text-body-muted"><%= number_with_delimiter(total_reactions) %> total</span>
    </div>
    <%= bar_chart reaction_data,
          colors: ["#1d4ed8"],
          height: "240px",
          library: {
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
          } %>
  <% end %>
<% end %>

<%# Impressions breakdown: organic vs paid %>
<% if impressions_data.values.sum > 0 %>
  <%= ui_card class: "mb-6" do %>
    <h2 class="text-sm font-semibold text-body-muted mb-4">Impressions Breakdown</h2>
    <%= ui_stats columns: 2, label: "Impressions breakdown" do |stats| %>
      <% stats.with_stat label: "Organic", value: number_with_delimiter(impressions_data["Organic"]) %>
      <% stats.with_stat label: "Paid", value: number_with_delimiter(impressions_data["Paid"]) %>
    <% end %>
  <% end %>
<% end %>

<%# Video metrics — only shown when the post has video %>
<% if media_type == "VIDEO" %>
  <% has_video_data = %w[post_video_views post_video_views_unique post_video_avg_time_watched post_video_view_time].any? { |k| metrics.key?(k) } %>
  <% if has_video_data %>
    <%= ui_card class: "mb-6" do %>
      <h2 class="text-sm font-semibold text-body-muted mb-4">Video Performance</h2>
      <%= ui_stats columns: 2, label: "Video performance" do |stats| %>
        <% if metrics.key?("post_video_views") %>
          <% stats.with_stat label: "Video Views (3s+)", value: number_with_delimiter(metrics["post_video_views"].to_i) %>
        <% end %>
        <% if metrics.key?("post_video_views_unique") %>
          <% stats.with_stat label: "Unique Video Views", value: number_with_delimiter(metrics["post_video_views_unique"].to_i) %>
        <% end %>
        <% if metrics.key?("post_video_avg_time_watched") %>
          <% stats.with_stat label: "Avg Watch Time", value: "#{(metrics["post_video_avg_time_watched"].to_f / 1000).round(1)}s" %>
        <% end %>
        <% if metrics.key?("post_video_view_time") %>
          <% stats.with_stat label: "Total View Time", value: "#{(metrics["post_video_view_time"].to_f / 1000 / 60).round(1)}m" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%# All metrics table %>
<%= ui_card body: false do |card| %>
  <% card.with_header { tag.h2("All Metrics", class: "text-sm font-semibold text-body-muted") } %>
  <%= ui_table hover: true, responsive: true, card: false, class: "mb-0" do |table| %>
    <% table.with_caption(visible: false) { "All metrics" } %>
    <thead>
      <tr>
        <%= ui_table_header "Metric" %>
        <%= ui_table_header "Value", class: "text-right" %>
      </tr>
    </thead>
    <tbody>
      <% metrics.each do |key, value| %>
        <tr>
          <td class="text-body-muted"><%= Facebook::InsightsService::METRIC_LABELS.fetch(key, key.humanize) %></td>
          <td class="text-right font-semibold"><%= number_with_delimiter(value.to_i) %></td>
        </tr>
      <% end %>
    </tbody>
  <% end %>
  <% card.with_footer do %>
    <span class="text-xs text-body-muted">Data from Meta Graph API &middot; External ID: <span class="font-mono"><%= post.external_post_id %></span></span>
  <% end %>
<% end %>
