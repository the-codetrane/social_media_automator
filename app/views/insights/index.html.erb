<% content_for :title, "Insights" %>

<%= ui_page_header title: "Insights",
                   subtitle: "#{@posts.size} published post#{"s" if @posts.size != 1} with data",
                   class: "mb-6" %>

<% if @weekly_series.any? { |s| s[:data].any? } %>
  <%= ui_card class: "mb-8",
              data: { controller: "insights-chart",
                      insights_chart_daily_value: @daily_series.to_json,
                      insights_chart_weekly_value: @weekly_series.to_json,
                      insights_chart_monthly_value: @monthly_series.to_json,
                      insights_chart_chart_id_value: "insights-performance-chart" } do %>
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <h2 data-insights-chart-target="title" class="text-sm font-semibold text-body-muted uppercase tracking-wide">Weekly Performance</h2>
      <%# TODO(L2): toggle group (the insights-chart controller toggles these classes) %>
      <div class="flex rounded-lg border border-border overflow-hidden text-xs font-medium shrink-0">
        <button data-insights-chart-target="toggle"
                data-action="click->insights-chart#switch"
                data-period="daily"
                class="px-3 py-1.5 bg-white text-gray-600 hover:bg-gray-50 transition-colors border-r border-border">Daily</button>
        <button data-insights-chart-target="toggle"
                data-action="click->insights-chart#switch"
                data-period="weekly"
                class="px-3 py-1.5 bg-indigo-600 text-white transition-colors border-r border-border">Weekly</button>
        <button data-insights-chart-target="toggle"
                data-action="click->insights-chart#switch"
                data-period="monthly"
                class="px-3 py-1.5 bg-white text-gray-600 hover:bg-gray-50 transition-colors">Monthly</button>
      </div>
    </div>
    <%= line_chart @weekly_series,
          id: "insights-performance-chart",
          height: "280px",
          colors: ["#6366f1", "#ec4899", "#f59e0b", "#10b981", "#3b82f6", "#8b5cf6", "#f97316"],
          library: {
            animation: { duration: 600, easing: "easeInOutQuart" },
            scales: {
              y: { beginAtZero: true, ticks: { precision: 0 } }
            },
            plugins: {
              legend: { position: "bottom", labels: { boxWidth: 12, padding: 16 } },
              tooltip: { mode: "index", intersect: false }
            },
            interaction: { mode: "index" },
            elements: { point: { radius: 3, hitRadius: 8 } }
          } %>
    <p class="text-xs text-body-muted mt-3">Metrics are populated when you view individual post insights. Open a post's detail page to load its data.</p>
  <% end %>
<% end %>

<% if @posts.empty? %>
  <%= ui_empty_state title: "No published posts found.", text: "Publish a post first to see its insights here." %>
<% else %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @posts.each do |post| %>
      <%= ui_card class: "h-full" do %>
        <div class="flex h-full flex-col gap-4">
          <div class="flex flex-wrap gap-2">
            <%= render PlatformBadgeComponent.new(platform: post.platform) %>
          </div>

          <% if post.caption.present? %>
            <p class="text-sm text-body line-clamp-3 leading-relaxed"><%= post.caption.truncate(140) %></p>
          <% else %>
            <p class="text-sm text-body-muted italic">No caption</p>
          <% end %>

          <%= ui_description_list layout: :inline, dividers: false, class: "text-sm" do |dl| %>
            <% if post.published_at.present? %>
              <% dl.with_item(term: "Published", description: post.published_at.strftime("%b %-d, %Y %H:%M")) %>
            <% end %>
            <% dl.with_item(term: "Owner", description: post.user&.name || "—") %>
          <% end %>

          <div class="mt-auto pt-3 border-t border-border">
            <%= ui_button "View Insights", href: insight_path(post), outline: true, size: :sm %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
