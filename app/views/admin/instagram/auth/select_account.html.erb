<% content_for :title, "Admin — Choose Instagram Account" %>

<%= ui_page_header title: "Choose an Instagram Account",
                   subtitle: "Select the Instagram Business or Creator account you want to connect.",
                   back: { href: admin_instagram_connect_path, label: "Instagram connection" }, class: "mb-6" %>

<%= ui_card class: "max-w-lg" do %>
  <% if @ig_accounts.empty? %>
    <%= ui_alert variant: :warning, class: "text-sm" do %>
      <strong>No Instagram Business Accounts found.</strong><br>
      Make sure your Instagram account is set to <strong>Business</strong> or <strong>Creator</strong>
      and is linked to a Facebook Page you manage.
    <% end %>
    <%= ui_button "Try again", href: admin_instagram_connect_path, variant: :secondary, outline: true %>
  <% else %>
    <ul class="divide-y divide-border">
      <% @ig_accounts.each do |account| %>
        <li class="py-3 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3 min-w-0">
            <% if account[:profile_picture_url].present? %>
              <img src="<%= account[:profile_picture_url] %>" alt="" class="size-10 rounded-full object-cover shrink-0">
            <% else %>
              <%= ui_avatar initials: account[:username].first.upcase, variant: :primary %>
            <% end %>
            <div class="min-w-0">
              <p class="font-medium text-body truncate">@<%= account[:username] %></p>
              <% if account[:page_name].present? %>
                <p class="text-xs text-body-muted truncate"><%= account[:page_name] %> (Facebook Page)</p>
              <% end %>
            </div>
          </div>

          <%= ui_button_to "Connect", admin_instagram_select_account_path, params: { ig_user_id: account[:ig_user_id] },
                           size: :sm, variant: :primary, aria: { label: "Connect @#{account[:username]}" } %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
