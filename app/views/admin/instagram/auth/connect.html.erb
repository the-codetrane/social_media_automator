<% content_for :title, "Admin — Instagram" %>
<% user = Current.user %>

<%= ui_page_header title: "Instagram Connection",
                   subtitle: "Authorise the app to publish posts to your Instagram Business Account.",
                   back: { href: admin_users_path, label: "Admin" }, class: "mb-6" %>

<%= render IntegrationCardComponent.new(name: "Instagram Account", connected: user&.instagram_connected?,
                                        account: ("@#{user.instagram_username}" if user&.instagram_username.present?)) do |card| %>
  <% card.with_logo { image_tag "instagram.svg", alt: "" } %>

  <% if user&.instagram_connected? %>
    <% if user.instagram_token_expiring? %>
      <%= ui_button_to "Refresh token (expires soon)", admin_instagram_refresh_token_path, variant: :warning %>
    <% end %>
    <%= ui_button href: @auth_url, variant: :secondary, outline: true do %>
      <%= render "admin/shared/reconnect_icon" %>
      Reconnect / switch account
    <% end %>
    <%= ui_button_to "Disconnect", admin_instagram_disconnect_path, method: :delete, variant: :danger, outline: true,
                     confirm: "Disconnect Instagram? Scheduled posts will fail until you reconnect." %>
  <% else %>
    <%= ui_button "Connect Instagram account", href: @auth_url, variant: :primary %>
  <% end %>
<% end %>
