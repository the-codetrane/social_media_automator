<% content_for :title, "Admin — TikTok" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">TikTok Connection</h1>
    <p class="text-sm text-gray-500 mt-1">Authorise the app to publish videos to your TikTok account.</p>
  </div>
  <%= link_to "← Admin", admin_users_path, class: "text-sm text-indigo-600 hover:text-indigo-800" %>
</div>

<% if flash[:notice] %>
  <div class="mb-6 px-4 py-3 rounded-lg bg-green-50 text-green-800 text-sm"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div class="mb-6 px-4 py-3 rounded-lg bg-red-50 text-red-800 text-sm"><%= flash[:alert] %></div>
<% end %>

<div class="max-w-lg bg-white rounded-xl shadow-sm border border-gray-200 p-8">
  <%# TikTok logo %>
  <div class="flex items-center gap-3 mb-6">
    <svg class="h-10 w-10" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
    </svg>
    <div>
      <p class="font-semibold text-gray-900">TikTok Account</p>
      <% if @connected %>
        <p class="text-sm text-green-600 font-medium">
          Connected
          <% if @username.present? %>— @<%= @username %><% end %>
        </p>
      <% else %>
        <p class="text-sm text-gray-400">Not connected</p>
      <% end %>
    </div>
  </div>

  <% if @connected %>
    <%# TikTok access tokens last 24 hours and are refreshed automatically before
        each API call; this panel just makes the current state visible. %>
    <div class="mb-6 px-4 py-3 rounded-lg bg-gray-50 text-sm text-gray-600">
      <% if @refresh_expired %>
        <p class="text-red-700 font-medium">The 365-day refresh token has expired — reconnect to keep publishing.</p>
      <% elsif @expires_at.present? %>
        <p>Access token valid until <%= @expires_at.strftime("%b %-d, %Y at %-l:%M %p") %>. Refreshed automatically.</p>
      <% end %>
    </div>

    <div class="flex flex-col gap-3">
      <%= button_to "Refresh access token", admin_tiktok_refresh_token_path, method: :post,
            class: "inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" %>
      <%= link_to "Reconnect / switch account", @auth_url,
            class: "inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" %>
      <%= button_to "Disconnect", admin_tiktok_disconnect_path, method: :delete,
            data: { turbo_confirm: "Disconnect TikTok? Scheduled posts will fail until you reconnect." },
            class: "inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-red-50 text-red-700 text-sm font-medium hover:bg-red-100 transition-colors" %>
    </div>
  <% else %>
    <%= link_to @auth_url,
          class: "inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-gray-900 text-white text-sm font-medium hover:bg-gray-800 transition-colors" do %>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
      </svg>
      Connect TikTok Account
    <% end %>
  <% end %>
</div>
