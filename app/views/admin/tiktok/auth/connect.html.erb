<% content_for :title, "Admin — TikTok" %>

<%= ui_page_header title: "TikTok Connection",
                   subtitle: "Authorise the app to publish videos to your TikTok account.",
                   back: { href: admin_users_path, label: "Admin" }, class: "mb-6" %>

<%= render IntegrationCardComponent.new(name: "TikTok Account", connected: @connected,
                                        account: ("@#{@username}" if @username.present?)) do |card| %>
  <% card.with_logo { image_tag "tiktok.svg", alt: "" } %>

  <%# Sandbox / production toggle. Tokens are not interchangeable between the
      two apps, so switching modes invalidates an existing connection. %>
  <% card.with_details do %>
    <div class="flex items-center justify-between gap-3 mb-3">
      <h3 class="text-sm font-medium text-body">Environment</h3>
      <%= ui_badge @mode, variant: (@mode == "sandbox" ? :warning : :success), pill: true %>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <% @modes.each do |m| %>
        <% current = m == @mode %>
        <%= ui_button_to admin_tiktok_mode_path, params: { mode: m }, disabled: current, size: :sm,
                         variant: (current ? :dark : :secondary), outline: !current,
                         confirm: ("Switch TikTok to #{m}? The current connection will need to be re-authorised." unless current) do %>
          <%= m.capitalize %><%= " — no credentials" unless @mode_configured[m] %>
        <% end %>
      <% end %>
    </div>

    <% unless @mode_configured[@mode] %>
      <%= ui_alert variant: :danger, class: "mt-3 mb-0 text-sm" do %>
        No client key/secret is configured for <%= @mode %>. Add them with
        <code class="font-mono text-xs">bin/rails credentials:edit</code> under
        <code class="font-mono text-xs">tiktok:<%= @mode %>:client_key</code>.
      <% end %>
    <% end %>

    <% if @mode_mismatch %>
      <%= ui_alert variant: :warning, class: "mt-3 mb-0 text-sm" do %>
        The connected account was authorised by the <strong><%= @environment %></strong> app.
        Reconnect below before publishing.
      <% end %>
    <% end %>
  <% end %>

  <% if @connected %>
    <%# TikTok access tokens last 24 hours and are refreshed automatically before
        each API call; this just makes the current state visible. %>
    <% if @refresh_expired %>
      <%= ui_alert "The 365-day refresh token has expired — reconnect to keep publishing.", variant: :danger, class: "mb-0 text-sm" %>
    <% elsif @expires_at.present? %>
      <p class="text-sm text-body-muted">Access token valid until <%= @expires_at.strftime("%b %-d, %Y at %-l:%M %p") %>. Refreshed automatically.</p>
    <% end %>

    <%= ui_button_to "Refresh access token", admin_tiktok_refresh_token_path, variant: :secondary, outline: true %>
    <% if @auth_url %>
      <%= ui_button href: @auth_url, variant: :secondary, outline: true do %>
        <%= render "admin/shared/reconnect_icon" %>
        Reconnect / switch account
      <% end %>
    <% end %>
    <%= ui_button_to "Disconnect", admin_tiktok_disconnect_path, method: :delete, variant: :danger, outline: true,
                     confirm: "Disconnect TikTok? Scheduled posts will fail until you reconnect." %>
  <% elsif @auth_url.nil? %>
    <p class="text-sm text-body-muted">Add credentials for the <%= @mode %> environment to connect.</p>
  <% else %>
    <%= ui_button "Connect TikTok account", href: @auth_url, variant: :primary %>
  <% end %>
<% end %>
