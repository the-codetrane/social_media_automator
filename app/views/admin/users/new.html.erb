<% content_for :title, "Invite User" %>

<%# TODO(L4): ui_page_header back: %>
<div class="mb-6">
  <%= link_to "← Back to Users", admin_users_path, class: "text-sm text-body-muted hover:text-body" %>
</div>

<div class="max-w-lg">
  <%= ui_page_header title: "Invite User", subtitle: "A welcome email with a link to set their password will be sent.", class: "mb-6" %>

  <%= ui_form_with model: [:admin, @user], class: "bg-surface rounded-xl shadow-sm border border-border p-6 space-y-5" do |f| %>
    <%= f.error_summary %>
    <%= f.text_field :name, placeholder: "Full name", autofocus: true %>
    <%= f.email_field :email_address, label: "Email", placeholder: "user@example.com" %>
    <%= f.switch :admin, label: "Admin", hint: "Can manage users and access the admin panel." %>

    <div class="pt-4 border-t border-border flex justify-end gap-3">
      <%= ui_button "Cancel", href: admin_users_path, variant: :secondary, outline: true %>
      <%= f.submit "Create & Send Invite", variant: :primary %>
    </div>
  <% end %>
</div>
