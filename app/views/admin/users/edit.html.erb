<% content_for :title, "Edit #{@user.name}" %>

<div class="mb-6">
  <%= link_to "← Back", admin_user_path(@user), class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>

<div class="max-w-lg">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Edit User</h1>

  <%= form_with model: [:admin, @user], class: "bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-5" do |f| %>
    <% if @user.errors.any? %>
      <div class="rounded-md bg-red-50 border border-red-200 p-4">
        <ul class="text-sm text-red-700 list-disc list-inside space-y-1">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500", autofocus: true %>
    </div>

    <div>
      <%= f.label :email_address, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email_address, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" %>
    </div>

    <div class="flex items-center gap-3">
      <%= f.check_box :admin, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
      <div>
        <%= f.label :admin, "Admin", class: "text-sm font-medium text-gray-700" %>
        <p class="text-xs text-gray-500">Can manage users and access the admin panel.</p>
      </div>
    </div>

    <div class="pt-2 flex gap-3">
      <%= f.submit "Save Changes", class: "flex-1 py-2 px-4 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors cursor-pointer" %>
      <%= link_to "Cancel", admin_user_path(@user), class: "flex-1 py-2 px-4 text-center text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
