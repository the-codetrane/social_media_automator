<% content_for :title, @user.name %>

<%# TODO(L4): ui_page_header back: %>
<div class="mb-4">
  <%= link_to "← Back to Users", admin_users_path, class: "text-sm text-body-muted hover:text-body" %>
</div>

<%= ui_page_header title: @user.name, subtitle: @user.email_address, class: "mb-6" do |header| %>
  <% header.with_badge(variant: @user.admin? ? :primary : :secondary, pill: true) { @user.admin? ? "Admin" : "User" } %>
  <% header.with_actions do %>
    <%= ui_button "Edit", href: edit_admin_user_path(@user), variant: :secondary, outline: true %>
    <%= button_to "Resend Invite", invite_admin_user_path(@user), method: :post,
        data: { turbo_confirm: "Send a new invite email to #{@user.email_address}?" },
        class: "px-3 py-1.5 text-base font-medium text-primary-on bg-primary border border-transparent rounded-ui hover:brightness-90 cursor-pointer" %>
    <% unless @user == Current.user %>
      <%= button_to "Delete", admin_user_path(@user), method: :delete,
          data: { turbo_confirm: "Delete #{@user.name}? This cannot be undone." },
          class: "px-3 py-1.5 text-base font-medium text-danger-on bg-danger border border-transparent rounded-ui hover:brightness-90 cursor-pointer" %>
    <% end %>
  <% end %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <%# Profile card %>
  <div class="lg:col-span-2 bg-surface rounded-xl shadow-sm border border-border p-6">
    <div class="flex items-center gap-4 mb-6">
      <%= ui_avatar name: @user.name, variant: :primary %>
      <p class="text-sm text-body-muted">Profile details</p>
    </div>

    <%= ui_description_list layout: :inline do |dl| %>
      <% dl.with_item(term: "Joined", description: @user.created_at.strftime("%B %-d, %Y")) %>
      <% dl.with_item(term: "Planned posts", description: @user.planned_posts.count.to_s) %>
      <% dl.with_item(term: "Instagram status") do %>
        <% if @user.instagram_connected? %>
          <% if @user.instagram_token_expiring? %>
            <%= ui_badge "Token expiring", variant: :warning, pill: true %>
          <% else %>
            <%= ui_badge "Connected", variant: :success, pill: true %>
          <% end %>
        <% else %>
          <span class="text-body-muted">Not connected</span>
        <% end %>
      <% end %>
      <% if @user.instagram_token_expires_at.present? %>
        <% dl.with_item(term: "Token expires", description: @user.instagram_token_expires_at.strftime("%b %-d, %Y")) %>
      <% end %>
      <% if @user.instagram_user_id.present? %>
        <% dl.with_item(term: "Instagram ID") do %>
          <span class="font-mono text-xs"><%= @user.instagram_user_id %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%# Password reset card %>
  <div class="bg-surface rounded-xl shadow-sm border border-border p-6">
    <h2 class="text-sm font-semibold text-body mb-4">Set Password</h2>
    <p class="text-xs text-body-muted mb-4">Directly update this user's password. Their active sessions will be invalidated.</p>

    <%= ui_form_with url: update_password_admin_user_path(@user), method: :patch, class: "space-y-3" do |f| %>
      <%= f.password_field "user[password]", label: "New Password", autocomplete: "new-password" %>
      <%= f.password_field "user[password_confirmation]", label: "Confirm Password", autocomplete: "new-password" %>
      <%= f.submit "Update Password", variant: :primary, class: "w-full" %>
    <% end %>
  </div>
</div>
