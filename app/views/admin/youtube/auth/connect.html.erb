<% content_for :title, "Admin — YouTube" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">YouTube Connection</h1>
    <p class="text-sm text-gray-500 mt-1">Authorise the app to publish videos to your YouTube channel.</p>
  </div>
  <%= link_to "← Admin", admin_users_path, class: "text-sm text-indigo-600 hover:text-indigo-800" %>
</div>

<div class="max-w-lg bg-white rounded-xl shadow-sm border border-gray-200 p-8">
  <%# YouTube logo %>
  <div class="flex items-center gap-3 mb-6">
    <svg class="h-10 w-10" viewBox="0 0 24 24" fill="#FF0000" xmlns="http://www.w3.org/2000/svg">
      <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
    </svg>
    <div>
      <p class="font-semibold text-gray-900">YouTube Channel</p>
      <% if @connected %>
        <p class="text-sm text-green-600 font-medium">
          Connected
          <% if @channel_title.present? %>— <%= @channel_title %><% end %>
        </p>
      <% else %>
        <p class="text-sm text-gray-400">Not connected</p>
      <% end %>
    </div>
  </div>

  <% if @connected %>
    <div class="flex flex-col gap-3">
      <%= link_to @auth_url,
            class: "inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
        Reconnect / switch channel
      <% end %>
      <%= button_to "Disconnect", admin_youtube_disconnect_path, method: :delete,
            data: { turbo_confirm: "Disconnect YouTube? Scheduled posts will fail until you reconnect." },
            class: "inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-red-50 text-red-700 text-sm font-medium hover:bg-red-100 transition-colors" %>
    </div>
  <% else %>
    <%= link_to @auth_url,
          class: "inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-red-600 text-white text-sm font-medium hover:bg-red-700 transition-colors" do %>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
      </svg>
      Connect YouTube Channel
    <% end %>
  <% end %>
</div>
