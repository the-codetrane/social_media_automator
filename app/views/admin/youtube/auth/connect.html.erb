<% content_for :title, "Admin — YouTube" %>

<%= ui_page_header title: "YouTube Connection",
                   subtitle: "Authorise the app to publish videos to your YouTube channel.",
                   back: { href: admin_users_path, label: "Admin" }, class: "mb-6" %>

<%= render IntegrationCardComponent.new(name: "YouTube Channel", connected: @connected, account: @channel_title) do |card| %>
  <% card.with_logo { image_tag "youtube.svg", alt: "" } %>

  <% if @connected %>
    <%= ui_button href: @auth_url, variant: :secondary, outline: true do %>
      <%= render "admin/shared/reconnect_icon" %>
      Reconnect / switch channel
    <% end %>
    <%= ui_button_to "Disconnect", admin_youtube_disconnect_path, method: :delete, variant: :danger, outline: true,
                     confirm: "Disconnect YouTube? Scheduled posts will fail until you reconnect." %>
  <% else %>
    <%= ui_button "Connect YouTube channel", href: @auth_url, variant: :primary %>
  <% end %>
<% end %>
