<%= form_with url: chat_messages_path,
              method: :post,
              multipart: true,
              id: "chat-form",
              data: { controller: "chat-form", action: "turbo:submit-end->chat-form#reset" },
              class: "flex flex-col gap-2" do |f| %>

  <div data-chat-form-target="preview" class="hidden items-center gap-2 px-1">
    <div class="relative inline-block">
      <img data-chat-form-target="previewImage"
           src="" alt="Preview"
           class="h-16 w-16 rounded-lg object-cover border border-gray-200" />
      <button type="button"
              data-action="click->chat-form#removeFile"
              class="absolute -top-1.5 -right-1.5 h-5 w-5 rounded-full bg-gray-600 text-white text-xs flex items-center justify-center hover:bg-red-600 transition-colors leading-none">
        &times;
      </button>
    </div>
  </div>

  <div class="flex items-end gap-2">
    <input type="file"
           name="attachment"
           accept="image/*"
           data-chat-form-target="fileInput"
           data-action="change->chat-form#previewFile"
           class="hidden" />

    <button type="button"
            data-action="click->chat-form#selectFile"
            title="Attach image"
            class="flex-shrink-0 p-2.5 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-md text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
      </svg>
    </button>

    <%= f.text_area :content,
          rows: 1,
          autofocus: true,
          required: true,
          placeholder: "Message…",
          data: { chat_form_target: "input", action: "keydown->chat-form#submitOnEnter input->chat-form#autosize" },
          class: "flex-1 resize-none rounded-md border border-gray-300 bg-white px-3 py-2 text-sm placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none max-h-40" %>

    <%= f.submit "Send",
          class: "inline-flex items-center px-4 py-2 min-h-[44px] rounded-md text-sm font-medium bg-indigo-600 text-white hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer" %>
  </div>
<% end %>
