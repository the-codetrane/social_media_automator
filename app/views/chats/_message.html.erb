<% role = message.role.to_s %>
<% is_user = role == "user" %>
<div id="<%= dom_id(message) %>" class="flex <%= is_user ? 'justify-end' : 'justify-start' %>">
  <div class="max-w-[92%] sm:max-w-[80%] rounded-2xl px-4 py-2 text-sm leading-relaxed break-words <%= is_user ? 'bg-primary text-primary-on rounded-br-sm whitespace-pre-wrap' : 'bg-surface-subtle text-body rounded-bl-sm chat-markdown' %>">
    <div class="text-xs opacity-60 mb-1"><%= role %></div>
    <% if is_user %>
      <% if message.attachments.attached? %>
        <div class="mb-1.5">
          <% message.attachments.each do |attachment| %>
            <%= image_tag rails_blob_path(attachment, disposition: "inline"),
                  class: "rounded-lg max-w-full max-h-48 object-contain",
                  alt: "Attached image" %>
          <% end %>
        </div>
      <% end %>
      <%= message.content %>
    <% else %>
      <%= render_markdown(message.content) %>
    <% end %>
  </div>
</div>
