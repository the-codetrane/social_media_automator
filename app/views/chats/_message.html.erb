<% role = message.role.to_s %>
<% is_user = role == "user" %>
<div id="<%= dom_id(message) %>" class="flex <%= is_user ? 'justify-end' : 'justify-start' %>">
  <div class="max-w-[80%] rounded-2xl px-4 py-2 text-sm leading-relaxed break-words <%= is_user ? 'bg-indigo-600 text-white rounded-br-sm whitespace-pre-wrap' : 'bg-gray-100 text-gray-900 rounded-bl-sm chat-markdown' %>">
    <div class="text-[10px] uppercase tracking-wide opacity-70 mb-1"><%= role %></div>
    <% if is_user %>
      <%= message.content %>
    <% else %>
      <%= render_markdown(message.content) %>
    <% end %>
  </div>
</div>
