<% content_for :title, "Chat" %>

<%= turbo_stream_from "chat_#{@chat.id}" %>

<div class="flex gap-5 items-start">

  <%# Main chat column %>
  <div class="flex-1 min-w-0">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Chat</h1>
        <p class="text-sm text-gray-500 mt-1">
          Talking with
          <span class="font-medium text-gray-700"><%= @chat.model&.model_id || RubyLLM.config.default_model %></span>
          &middot; session #<%= @chat.id %>
        </p>
      </div>
      <%= button_to "Clear",
            destroy_chat_path,
            method: :delete,
            form: { data: { turbo_confirm: "Clear this conversation and start fresh?" } },
            class: "px-3 py-2 rounded-md text-sm font-medium bg-white border border-gray-300 text-gray-700 hover:bg-red-50 hover:border-red-300 hover:text-red-700 transition-colors" %>
    </div>

    <div data-controller="chat"
         class="bg-white rounded-xl shadow-sm border border-gray-200 flex flex-col"
         style="height: calc(100vh - 14rem); min-height: 400px;">
      <div id="chat-messages"
           data-chat-target="log"
           class="flex-1 overflow-y-auto px-5 py-6 space-y-3">
        <% if @messages.empty? %>
          <div id="chat-empty" class="text-center text-sm text-gray-400 py-12">
            Say something to get started.
          </div>
        <% else %>
          <%= render partial: "chats/message", collection: @messages, as: :message %>
        <% end %>
      </div>

      <div class="border-t border-gray-200 px-4 py-3 bg-gray-50 rounded-b-xl">
        <%= render "chats/form", chat: @chat %>
      </div>
    </div>
  </div>

  <%# Model selector side panel %>
  <div class="w-64 flex-shrink-0 mt-16">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden"
         style="max-height: calc(100vh - 14rem);">
      <div class="px-4 py-3 border-b border-gray-100 bg-gray-50">
        <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Model</h2>
      </div>
      <div class="overflow-y-auto divide-y divide-gray-100" style="max-height: calc(100vh - 17rem);">
        <% current_model_id = @chat.model&.model_id || RubyLLM.config.default_model %>
        <% ChatsController::MODELS.each do |m| %>
          <% selected = current_model_id == m[:id] %>
          <%= button_to chat_model_path,
                params: { model_id: m[:id] },
                method: :post,
                class: "w-full text-left p-4 transition-colors #{selected ? 'bg-indigo-50' : 'bg-white hover:bg-gray-50'}" do %>
            <div class="flex items-center justify-between mb-0.5">
              <span class="text-sm font-semibold <%= selected ? 'text-indigo-700' : 'text-gray-900' %>">
                <%= m[:display_name] %>
              </span>
              <% if selected %>
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-indigo-100 text-indigo-700">
                  Active
                </span>
              <% end %>
            </div>
            <p class="text-xs text-gray-400 mb-2"><%= m[:tagline] %></p>
            <p class="text-xs text-gray-600 mb-3 leading-relaxed"><%= m[:description] %></p>
            <div class="space-y-1">
              <% m[:strengths].each do |s| %>
                <div class="flex items-start gap-1.5">
                  <span class="text-green-500 text-xs mt-0.5 flex-shrink-0">+</span>
                  <span class="text-xs text-gray-600"><%= s %></span>
                </div>
              <% end %>
              <% m[:limitations].each do |l| %>
                <div class="flex items-start gap-1.5">
                  <span class="text-red-400 text-xs mt-0.5 flex-shrink-0">&minus;</span>
                  <span class="text-xs text-gray-500"><%= l %></span>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

</div>
