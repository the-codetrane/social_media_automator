<%# Flat until the library's navbar menus (L1) land; then Content and Analytics become menus. %>
<% account_name = Current.user&.name.presence || Current.user&.email_address %>
<% admin_active = controller.class.module_parent == Admin %>
<% nav_items = [
  ["Users", users_path, controller_name == "users" && !admin_active],
  (["Admin", admin_users_path, admin_active] if Current.user&.admin?),
  ["Planned Posts", planned_posts_path, controller_name == "planned_posts"],
  ["Media Assets", media_assets_path, controller_name == "media_assets"],
  ["Templates", social_templates_path, controller_name == "social_templates"],
  ["Chat", chat_path, controller_name == "chats"],
  ["Known People", known_people_path, controller_name == "known_people"],
  ["Insights", insights_path, controller_name == "insights"],
  ["LLM Costs", llm_costs_path, controller_name == "llm_costs"]
].compact %>

<%= ui_navbar label: "Main", expand: :xl, theme: :surface, class: "border-b border-border mb-8" do |navbar| %>
  <% navbar.with_brand(href: root_path, class: "flex items-center gap-2") do %>
    <%= image_tag "/icon.png", alt: "", class: "w-7 h-7 shrink-0" %>
    <span class="font-bold text-sm tracking-tight">SMA</span>
  <% end %>
  <% nav_items.each do |label, path, active| %>
    <% navbar.with_item(label, href: path, active: active) %>
  <% end %>
  <% if authenticated? %>
    <% navbar.with_actions do %>
      <%= ui_dropdown(placement: "bottom-end") do |menu| %>
        <% menu.with_trigger(variant: :link, aria: { label: "Account menu" }) do %>
          <%= ui_avatar name: account_name, size: :sm %>
        <% end %>
        <% menu.with_header(account_name) %>
        <% menu.with_item("Sign out", href: session_path, method: :delete) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
