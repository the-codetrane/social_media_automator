<%# locals: (pagy:, frame: nil) %>
<% if pagy.pages > 1 %>
  <nav class="flex items-center justify-between mt-6 px-1" aria-label="Pagination">
    <p class="text-sm text-gray-500">
      Showing <span class="font-medium"><%= pagy.from %></span>–<span class="font-medium"><%= pagy.to %></span>
      of <span class="font-medium"><%= pagy.count %></span>
    </p>
    <div class="flex items-center gap-1">
      <% if pagy.prev %>
        <%= link_to "‹ Prev", pagy_url_for(pagy, pagy.prev),
            class: "px-3 py-1.5 text-sm text-gray-600 rounded-md hover:bg-gray-100 border border-gray-200 transition-colors",
            data: { turbo_frame: frame, turbo_action: "advance" } %>
      <% else %>
        <span class="px-3 py-1.5 text-sm text-gray-300 rounded-md border border-gray-200 cursor-not-allowed select-none">‹ Prev</span>
      <% end %>

      <span class="px-3 py-1.5 text-sm font-medium text-white bg-indigo-600 rounded-md">
        <%= pagy.page %> / <%= pagy.pages %>
      </span>

      <% if pagy.next %>
        <%= link_to "Next ›", pagy_url_for(pagy, pagy.next),
            class: "px-3 py-1.5 text-sm text-gray-600 rounded-md hover:bg-gray-100 border border-gray-200 transition-colors",
            data: { turbo_frame: frame, turbo_action: "advance" } %>
      <% else %>
        <span class="px-3 py-1.5 text-sm text-gray-300 rounded-md border border-gray-200 cursor-not-allowed select-none">Next ›</span>
      <% end %>
    </div>
  </nav>
<% end %>
