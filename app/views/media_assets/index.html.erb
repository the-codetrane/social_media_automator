<% content_for :title, "Media Assets" %>

<%
  type_colors = {
    "image" => "bg-purple-100 text-purple-800",
    "video" => "bg-pink-100 text-pink-800"
  }
  availability_tabs = [
    [ "available", "Available" ],
    [ "reserved",  "Scheduled" ],
    [ "published", "Published" ],
    [ "archived",  "Archived" ],
    [ "all",       "All" ]
  ]
  sort_base = { q: @query, availability: @availability }
  sort_header = lambda do |label, column, **opts|
    active = @sort == column
    next_dir = (active && @direction == "asc") ? "desc" : "asc"
    ui_sort_header label,
      href: media_assets_path(sort_base.merge(sort: column, direction: next_dir, page: 1)),
      direction: (active ? @direction&.to_sym : nil),
      link: { data: { turbo_frame: "media-assets-list", turbo_action: "advance" } },
      **opts
  end
  mime_icon = '<svg class="w-12 h-12 text-body-muted opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>'.html_safe
%>

<div data-controller="view-toggle"
     data-view-toggle-storage-key-value="media_assets_view">

  <%= ui_page_header title: "Media Assets", subtitle: "#{@pagy.count} record#{"s" if @pagy.count != 1}", class: "mb-6" do |header| %>
    <% header.with_actions do %>
      <%= ui_button href: new_media_asset_path, variant: :primary, data: { turbo_frame: "media-upload-modal" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0-12l-4 4m4-4l4 4"/>
        </svg>
        Upload media
      <% end %>
      <%# Card/table view. The choice is stored in localStorage by view_toggle_controller. %>
      <%= ui_toggle_group name: "media_assets_view", type: :radio, style: :segmented, label: "View", legend_visible: false do |group| %>
        <% group.with_option(value: "card", label: "Card view", icon_only: true, checked: true,
                             data: { view_toggle_target: "cardInput", action: "change->view-toggle#showCard" }) do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
          </svg>
        <% end %>
        <% group.with_option(value: "table", label: "Table view", icon_only: true,
                             data: { view_toggle_target: "tableInput", action: "change->view-toggle#showTable" }) do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M3 14h18M10 6h11M10 18h11M3 6h.01M3 18h.01" />
          </svg>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%# Upload modal — the form is fetched into the frame when the CTA is clicked,
      and the dialog opens once it has loaded. The dialog keeps data-controller="modal"
      because media_assets/new closes it with modal#close. %>
  <%= ui_modal size: :lg, aria: { label: "Upload media" }, data: { controller: "modal", action: "turbo:frame-load->cl-dialog#open" } do %>
    <%= turbo_frame_tag "media-upload-modal" %>
  <% end %>

  <%# Availability filter — Available hides assets that are archived, already
      published, or on a scheduled post, so they are not picked twice. %>
  <%= ui_nav style: :tabs, label: "Filter by availability", class: "mb-4 flex-wrap" do |nav| %>
    <% availability_tabs.each do |value, label| %>
      <% nav.with_item(label,
           href: media_assets_path(availability: value, q: @query.presence, sort: @sort, direction: @direction),
           active: @availability == value) %>
    <% end %>
  <% end %>

  <%# Search form — targets the media-assets-list turbo frame %>
  <%= ui_form_with url: media_assets_path,
                   method: :get,
                   data: { turbo_frame: "media-assets-list", turbo_action: "advance" },
                   class: "mb-4 max-w-sm" do |f| %>
    <%= hidden_field_tag :sort, @sort, id: nil %>
    <%= hidden_field_tag :direction, @direction, id: nil %>
    <%= hidden_field_tag :availability, @availability, id: nil %>
    <%= f.search_field :q, value: @query, label: false, placeholder: "Search by filename…",
                       autocomplete: "off", aria: { label: "Search by filename" },
                       autosubmit: { delay: 300 }, wrapper: { class: "mb-0" } %>
  <% end %>

  <%# Selection and bulk actions: cl-bulk-select wraps the list and the bar, and the
      form submits the checked ids[] to the archive / restore endpoint. %>
  <%= form_with url: (@availability == "archived" ? bulk_unarchive_media_assets_path : bulk_archive_media_assets_path),
                method: :patch,
                data: { controller: "cl-bulk-select", turbo_frame: "_top" } do %>

    <%= ui_bulk_action_bar label: "Media actions", noun: "asset", noun_plural: "assets", position: :top, class: "mb-4" do |bar| %>
      <% if @availability == "archived" %>
        <% bar.with_action { ui_button "Restore", type: :submit, variant: :primary, outline: true, size: :sm } %>
      <% else %>
        <% bar.with_action { ui_button "Archive", type: :submit, variant: :secondary, outline: true, size: :sm } %>
      <% end %>
    <% end %>

    <%= turbo_frame_tag "media-assets-list",
          data: { action: "turbo:frame-render->cl-bulk-select#clear turbo:frame-render->view-toggle#applyView" } do %>

      <% if @media_assets.empty? %>
        <%= ui_empty_state title: (@availability == "available" ? "No unused media assets found." : "No media assets found.") %>
      <% else %>

        <%# ── Card view ────────────────────────────────────────────────────── %>
        <div data-view-toggle-target="cardView">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <% @media_assets.each do |asset| %>
              <% availability = asset.availability(reserved_ids: @reserved_ids) %>
              <%# data-turbo-frame="_top": the card link must leave the list frame. %>
              <div class="relative has-checked:ring-2 has-checked:ring-primary has-checked:ring-offset-1 rounded-ui" data-turbo-frame="_top">
                <%# Selection checkbox — it sits above the card's stretched link so a click doesn't navigate %>
                <%= ui_selection_checkbox label: "Select #{asset.display_name}", value: asset.id,
                      class: "absolute top-3 left-3 z-10" %>
                <%= ui_card href: media_asset_path(asset), link_label: decode_name(asset.external_name.presence || asset.external_id),
                      class: "h-full #{"opacity-60" if availability == "archived"}", body: false do |card| %>
                  <% card.with_media(aspect: :video, class: "bg-surface-subtle") do %>
                    <% if asset.public_url? %>
                      <% if asset.image? %>
                        <%= image_tag asset.public_url, alt: decode_name(asset.external_name.presence || "Media asset") %>
                      <% elsif asset.video? %>
                        <video preload="metadata" muted>
                          <source src="<%= asset.public_url %>" type="<%= asset.mime_type || "video/mp4" %>">
                        </video>
                      <% end %>
                    <% else %>
                      <div class="h-full flex items-center justify-center"><%= mime_icon %></div>
                    <% end %>
                  <% end %>

                  <div class="p-5 flex flex-col gap-4 flex-auto">
                    <%# Header %>
                    <div class="flex items-start justify-between gap-2">
                      <p class="font-semibold text-body truncate flex-1">
                        <%= decode_name(asset.external_name.presence || asset.external_id) %>
                      </p>
                      <div class="flex shrink-0 flex-col items-end gap-1">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= type_colors[asset.media_type] || "bg-surface-subtle text-body-muted" %> capitalize">
                          <%= asset.media_type %>
                        </span>
                        <%= render StatusBadgeComponent.new(status: asset.status, kind: :media) %>
                        <%# The availability badge also labels archived cards, so the fade is not the only cue. %>
                        <%= render "media_assets/availability_badge", availability: availability %>
                      </div>
                    </div>

                    <%# Metadata grid %>
                    <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
                      <% if asset.width.present? && asset.height.present? %>
                        <div>
                          <dt class="text-body-muted uppercase tracking-wide">Dimensions</dt>
                          <dd class="text-body"><%= asset.width %> × <%= asset.height %></dd>
                        </div>
                      <% end %>
                      <% if asset.media_type == "video" && asset.duration_seconds.present? %>
                        <div>
                          <dt class="text-body-muted uppercase tracking-wide">Duration</dt>
                          <dd class="text-body">
                            <%
                              mins = (asset.duration_seconds / 60).floor
                              secs = (asset.duration_seconds % 60).round
                            %>
                            <%= mins > 0 ? "#{mins}m #{secs}s" : "#{secs}s" %>
                          </dd>
                        </div>
                      <% end %>
                      <% if asset.file_size.present? %>
                        <div>
                          <dt class="text-body-muted uppercase tracking-wide">File Size</dt>
                          <dd class="text-body"><%= number_to_human_size(asset.file_size) %></dd>
                        </div>
                      <% end %>
                      <% if asset.mime_type.present? %>
                        <div>
                          <dt class="text-body-muted uppercase tracking-wide">Format</dt>
                          <dd class="text-body truncate"><%= asset.mime_type.split("/").last&.upcase %></dd>
                        </div>
                      <% end %>
                      <div>
                        <dt class="text-body-muted uppercase tracking-wide">First Seen</dt>
                        <dd class="text-body"><%= asset.first_seen_at.strftime("%b %-d, %Y") %></dd>
                      </div>
                      <% if asset.last_processed_at.present? %>
                        <div>
                          <dt class="text-body-muted uppercase tracking-wide">Processed</dt>
                          <dd class="text-body"><%= asset.last_processed_at.strftime("%b %-d, %Y") %></dd>
                        </div>
                      <% end %>
                      <div>
                        <dt class="text-body-muted uppercase tracking-wide">Posts</dt>
                        <dd class="text-body font-semibold"><%= asset.planned_posts.size %></dd>
                      </div>
                    </dl>

                    <p class="text-xs text-body-muted border-t border-border pt-3 mt-auto">
                      Added <%= asset.created_at.strftime("%b %-d, %Y") %>
                      <% if asset.published? %>
                        · Published <%= asset.published_at.strftime("%b %-d, %Y") %>
                      <% end %>
                    </p>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <%# ── Table view ───────────────────────────────────────────────────── %>
        <div data-view-toggle-target="tableView" class="hidden">
          <%= ui_table hover: true, responsive: true do |table| %>
            <% table.with_caption(visible: false) { "Media assets" } %>
            <thead>
              <tr>
                <th class="w-10"><%= ui_select_all_checkbox label: "Select all media assets" %></th>
                <th class="w-14"><span class="sr-only">Preview</span></th>
                <%= sort_header.call("Name", "external_name") %>
                <%= sort_header.call("Type", "media_type") %>
                <%= sort_header.call("Status", "status") %>
                <%= sort_header.call("Published", "published_at") %>
                <%= ui_table_header "Dimensions" %>
                <%= sort_header.call("File Size", "file_size") %>
                <%= ui_table_header "Posts" %>
                <%= sort_header.call("First Seen", "first_seen_at", class: "whitespace-nowrap") %>
                <th class="w-10"><span class="sr-only">View</span></th>
              </tr>
            </thead>
            <tbody>
              <% @media_assets.each do |asset| %>
                <% availability = asset.availability(reserved_ids: @reserved_ids) %>
                <tr class="<%= "opacity-60" if availability == "archived" %>">
                  <td>
                    <%= ui_selection_checkbox label: "Select #{asset.display_name}", value: asset.id %>
                  </td>
                  <td>
                    <div class="h-10 w-10 rounded-ui-sm overflow-hidden bg-surface-subtle flex-shrink-0">
                      <% if asset.public_url? %>
                        <% if asset.image? %>
                          <%= image_tag asset.public_url, class: "h-10 w-10 object-cover", alt: "" %>
                        <% elsif asset.video? %>
                          <video class="h-10 w-10 object-cover" preload="metadata" muted>
                            <source src="<%= asset.public_url %>" type="<%= asset.mime_type || "video/mp4" %>">
                          </video>
                        <% end %>
                      <% else %>
                        <div class="h-10 w-10 flex items-center justify-center text-body-muted opacity-50">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                          </svg>
                        </div>
                      <% end %>
                    </div>
                  </td>
                  <td class="max-w-xs">
                    <span class="text-body font-medium truncate block">
                      <%= decode_name(asset.external_name.presence || asset.external_id) %>
                    </span>
                  </td>
                  <td>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= type_colors[asset.media_type] || "bg-surface-subtle text-body-muted" %> capitalize">
                      <%= asset.media_type %>
                    </span>
                  </td>
                  <td>
                    <div class="flex flex-wrap gap-1">
                      <%= render StatusBadgeComponent.new(status: asset.status, kind: :media) %>
                      <%= render "media_assets/availability_badge", availability: availability %>
                    </div>
                  </td>
                  <td class="text-body-muted whitespace-nowrap">
                    <%= asset.published? ? asset.published_at.strftime("%b %-d, %Y") : "—" %>
                  </td>
                  <td class="text-body-muted whitespace-nowrap">
                    <% if asset.width.present? && asset.height.present? %>
                      <%= asset.width %> × <%= asset.height %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                  <td class="text-body-muted whitespace-nowrap">
                    <%= asset.file_size.present? ? number_to_human_size(asset.file_size) : "—" %>
                  </td>
                  <td class="text-body font-semibold text-center">
                    <%= asset.planned_posts.size %>
                  </td>
                  <td class="text-body-muted whitespace-nowrap">
                    <%= asset.first_seen_at.strftime("%b %-d, %Y") %>
                  </td>
                  <td>
                    <%= link_to media_asset_path(asset), class: "text-body-muted hover:text-primary transition-colors", data: { turbo_frame: "_top" },
                          aria: { label: "View #{asset.display_name}" } do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                      </svg>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          <% end %>
        </div>

      <% end %>

      <%= ui_pagy @pagy, frame: "media-assets-list" %>

    <% end %>
  <% end %>

</div>
