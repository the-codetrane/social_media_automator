<% content_for :title, "Media Assets" %>

<%
  status_colors = {
    "discovered" => "bg-yellow-100 text-yellow-800",
    "processed"  => "bg-green-100 text-green-800",
    "failed"     => "bg-red-100 text-red-800",
    "archived"   => "bg-gray-100 text-gray-600"
  }
  type_colors = {
    "image" => "bg-purple-100 text-purple-800",
    "video" => "bg-pink-100 text-pink-800"
  }
%>

<div data-controller="view-toggle" data-view-toggle-storage-key-value="media_assets_view">

  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Media Assets</h1>
      <p class="text-sm text-gray-500 mt-1"><%= @pagy.count %> record<%= "s" if @pagy.count != 1 %></p>
    </div>
    <div class="flex items-center gap-1 bg-gray-100 rounded-lg p-1">
      <button type="button"
              data-view-toggle-target="cardButton"
              data-action="click->view-toggle#showCard"
              title="Card view"
              class="p-1.5 rounded-md transition-colors text-gray-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
        </svg>
      </button>
      <button type="button"
              data-view-toggle-target="tableButton"
              data-action="click->view-toggle#showTable"
              title="Table view"
              class="p-1.5 rounded-md transition-colors text-gray-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M3 14h18M10 6h11M10 18h11M3 6h.01M3 18h.01" />
        </svg>
      </button>
    </div>
  </div>

  <%# Search form — targets the media-assets-list turbo frame %>
  <%= form_with url: media_assets_path,
                method: :get,
                data: { controller: "debounced-search",
                        turbo_frame: "media-assets-list",
                        turbo_action: "advance" },
                class: "mb-4" do %>
    <input type="hidden" name="sort" value="<%= @sort %>">
    <input type="hidden" name="direction" value="<%= @direction %>">
    <div class="relative max-w-sm">
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
        <svg class="h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
        </svg>
      </div>
      <input type="search"
             name="q"
             value="<%= @query %>"
             placeholder="Search by filename…"
             autocomplete="off"
             data-action="input->debounced-search#search"
             class="block w-full rounded-lg border border-gray-300 bg-white py-2 pl-9 pr-3 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none">
    </div>
  <% end %>

  <%= turbo_frame_tag "media-assets-list",
        data: { action: "turbo:frame-render->view-toggle#applyView" } do %>

    <% if @media_assets.empty? %>
      <div class="text-center py-20 text-gray-400">No media assets found.</div>
    <% else %>

      <%# ── Card view ──────────────────────────────────────────────────────── %>
      <div data-view-toggle-target="cardView">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @media_assets.each do |asset| %>
            <%= link_to media_asset_path(asset), class: "bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col hover:shadow-md hover:border-gray-300 transition-all duration-200 cursor-pointer", data: { turbo_frame: "_top" } do %>

              <%# Media Preview Thumbnail %>
              <% if asset.public_url? %>
                <div class="aspect-video bg-gray-100 overflow-hidden">
                  <% if asset.image? %>
                    <%= image_tag asset.public_url,
                        class: "w-full h-full object-cover",
                        alt: decode_name(asset.external_name.presence || "Media asset") %>
                  <% elsif asset.video? %>
                    <video
                      class="w-full h-full object-cover"
                      preload="metadata"
                      muted
                    >
                      <source src="<%= asset.public_url %>" type="<%= asset.mime_type || 'video/mp4' %>">
                    </video>
                  <% end %>
                </div>
              <% else %>
                <div class="aspect-video bg-gray-100 flex items-center justify-center">
                  <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
              <% end %>

              <div class="p-5 flex flex-col gap-4">
                <%# Header %>
                <div class="flex items-start justify-between gap-2">
                  <p class="font-semibold text-gray-900 truncate flex-1">
                    <%= decode_name(asset.external_name.presence || asset.external_id) %>
                  </p>
                  <div class="flex shrink-0 flex-col items-end gap-1">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= type_colors[asset.media_type] || 'bg-gray-100 text-gray-600' %> capitalize">
                      <%= asset.media_type %>
                    </span>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= status_colors[asset.status] || 'bg-gray-100 text-gray-600' %> capitalize">
                      <%= asset.status %>
                    </span>
                  </div>
                </div>

                <%# Metadata grid %>
                <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
                  <% if asset.width.present? && asset.height.present? %>
                    <div>
                      <dt class="text-gray-400 uppercase tracking-wide">Dimensions</dt>
                      <dd class="text-gray-700"><%= asset.width %> × <%= asset.height %></dd>
                    </div>
                  <% end %>
                  <% if asset.media_type == "video" && asset.duration_seconds.present? %>
                    <div>
                      <dt class="text-gray-400 uppercase tracking-wide">Duration</dt>
                      <dd class="text-gray-700">
                        <%
                          mins = (asset.duration_seconds / 60).floor
                          secs = (asset.duration_seconds % 60).round
                        %>
                        <%= mins > 0 ? "#{mins}m #{secs}s" : "#{secs}s" %>
                      </dd>
                    </div>
                  <% end %>
                  <% if asset.file_size.present? %>
                    <div>
                      <dt class="text-gray-400 uppercase tracking-wide">File Size</dt>
                      <dd class="text-gray-700"><%= number_to_human_size(asset.file_size) %></dd>
                    </div>
                  <% end %>
                  <% if asset.mime_type.present? %>
                    <div>
                      <dt class="text-gray-400 uppercase tracking-wide">Format</dt>
                      <dd class="text-gray-700 truncate"><%= asset.mime_type.split("/").last&.upcase %></dd>
                    </div>
                  <% end %>
                  <div>
                    <dt class="text-gray-400 uppercase tracking-wide">First Seen</dt>
                    <dd class="text-gray-700"><%= asset.first_seen_at.strftime("%b %-d, %Y") %></dd>
                  </div>
                  <% if asset.last_processed_at.present? %>
                    <div>
                      <dt class="text-gray-400 uppercase tracking-wide">Processed</dt>
                      <dd class="text-gray-700"><%= asset.last_processed_at.strftime("%b %-d, %Y") %></dd>
                    </div>
                  <% end %>
                  <div>
                    <dt class="text-gray-400 uppercase tracking-wide">Posts</dt>
                    <dd class="text-gray-700 font-semibold"><%= asset.planned_posts.size %></dd>
                  </div>
                </dl>

                <p class="text-xs text-gray-400 border-t border-gray-100 pt-3 mt-auto">
                  Added <%= asset.created_at.strftime("%b %-d, %Y") %>
                </p>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <%# ── Table view ─────────────────────────────────────────────────────── %>
      <div data-view-toggle-target="tableView" class="hidden">
        <% sort_base = { q: @query } %>
        <% sort_data = { turbo_frame: "media-assets-list", turbo_action: "advance" } %>
        <div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th class="w-14 px-4 py-3"></th>
                <th class="px-4 py-3 text-left">
                  <%= sort_link_to "Name", "external_name",
                      current_sort: @sort, current_direction: @direction,
                      base_params: sort_base, data: sort_data,
                      class: "text-xs font-medium uppercase tracking-wide" %>
                </th>
                <th class="px-4 py-3 text-left">
                  <%= sort_link_to "Type", "media_type",
                      current_sort: @sort, current_direction: @direction,
                      base_params: sort_base, data: sort_data,
                      class: "text-xs font-medium uppercase tracking-wide" %>
                </th>
                <th class="px-4 py-3 text-left">
                  <%= sort_link_to "Status", "status",
                      current_sort: @sort, current_direction: @direction,
                      base_params: sort_base, data: sort_data,
                      class: "text-xs font-medium uppercase tracking-wide" %>
                </th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Dimensions</th>
                <th class="px-4 py-3 text-left">
                  <%= sort_link_to "File Size", "file_size",
                      current_sort: @sort, current_direction: @direction,
                      base_params: sort_base, data: sort_data,
                      class: "text-xs font-medium uppercase tracking-wide" %>
                </th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Posts</th>
                <th class="px-4 py-3 text-left whitespace-nowrap">
                  <%= sort_link_to "First Seen", "first_seen_at",
                      current_sort: @sort, current_direction: @direction,
                      base_params: sort_base, data: sort_data,
                      class: "text-xs font-medium uppercase tracking-wide" %>
                </th>
                <th class="w-10 px-4 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @media_assets.each do |asset| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-3">
                    <div class="h-10 w-10 rounded-md overflow-hidden bg-gray-100 flex-shrink-0">
                      <% if asset.public_url? %>
                        <% if asset.image? %>
                          <%= image_tag asset.public_url,
                              class: "h-10 w-10 object-cover",
                              alt: "" %>
                        <% elsif asset.video? %>
                          <video class="h-10 w-10 object-cover" preload="metadata" muted>
                            <source src="<%= asset.public_url %>" type="<%= asset.mime_type || 'video/mp4' %>">
                          </video>
                        <% end %>
                      <% else %>
                        <div class="h-10 w-10 flex items-center justify-center">
                          <svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                          </svg>
                        </div>
                      <% end %>
                    </div>
                  </td>
                  <td class="px-4 py-3 max-w-xs">
                    <span class="text-gray-900 font-medium truncate block">
                      <%= decode_name(asset.external_name.presence || asset.external_id) %>
                    </span>
                  </td>
                  <td class="px-4 py-3">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= type_colors[asset.media_type] || 'bg-gray-100 text-gray-600' %> capitalize">
                      <%= asset.media_type %>
                    </span>
                  </td>
                  <td class="px-4 py-3">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= status_colors[asset.status] || 'bg-gray-100 text-gray-600' %> capitalize">
                      <%= asset.status %>
                    </span>
                  </td>
                  <td class="px-4 py-3 text-gray-600 whitespace-nowrap">
                    <% if asset.width.present? && asset.height.present? %>
                      <%= asset.width %> × <%= asset.height %>
                    <% else %>
                      <span class="text-gray-400">—</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-gray-600 whitespace-nowrap">
                    <%= asset.file_size.present? ? number_to_human_size(asset.file_size) : "—" %>
                  </td>
                  <td class="px-4 py-3 text-gray-700 font-semibold text-center">
                    <%= asset.planned_posts.size %>
                  </td>
                  <td class="px-4 py-3 text-gray-600 whitespace-nowrap">
                    <%= asset.first_seen_at.strftime("%b %-d, %Y") %>
                  </td>
                  <td class="px-4 py-3">
                    <%= link_to media_asset_path(asset), class: "text-gray-400 hover:text-indigo-600 transition-colors", data: { turbo_frame: "_top" } do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                      </svg>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

    <% end %>

    <%= render "shared/pagination", pagy: @pagy, frame: "media-assets-list" %>

  <% end %>

</div>
