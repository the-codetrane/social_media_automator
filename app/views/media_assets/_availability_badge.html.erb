<%# Reuse state of a media asset. Nothing is shown for "available" — the
    absence of a badge is the signal that the asset is free to use. %>
<%
  badges = {
    "archived"  => [ "Archived",  :secondary ],
    "published" => [ "Published", :info ],
    "reserved"  => [ "Scheduled", :warning ]
  }
  label, variant = badges[availability]
  size_class = local_assigns[:size] == :large ? "text-base" : nil
%>
<% if label %>
  <%= ui_badge label, variant: variant, pill: true, class: size_class %>
<% end %>
