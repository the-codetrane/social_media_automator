<%# Reuse state of a media asset. Nothing is shown for "available" — the
    absence of a badge is the signal that the asset is free to use. %>
<%
  badges = {
    "archived"  => [ "Archived",  "bg-gray-200 text-gray-700" ],
    "published" => [ "Published", "bg-blue-100 text-blue-800" ],
    "reserved"  => [ "Scheduled", "bg-amber-100 text-amber-800" ]
  }
  label, classes = badges[availability]
  size = local_assigns[:size] == :large ? "px-3 py-1 text-sm" : "px-2 py-0.5 text-xs"
%>
<% if label %>
  <span class="inline-flex items-center rounded-full font-medium <%= size %> <%= classes %>"><%= label %></span>
<% end %>
