<% content_for :title, decode_name(@media_asset.external_name.presence || @media_asset.external_id) %>

<%
  display_name = decode_name(@media_asset.external_name.presence || @media_asset.external_id)
  type_variants = { "image" => :info, "video" => :primary }
%>

<div class="max-w-3xl mx-auto">
  <%= ui_page_header title: display_name, back: {href: media_assets_path, label: "Media assets"}, class: "mb-6" do |header| %>
    <% header.with_actions do %>
      <% if @media_asset.archived? %>
        <%= button_to "Restore", unarchive_media_asset_path(@media_asset), method: :patch,
              class: "inline-flex items-center px-3 py-1.5 border border-border bg-surface text-body text-base font-medium rounded-lg hover:bg-surface-subtle transition-colors cursor-pointer" %>
      <% else %>
        <%= button_to "Archive", archive_media_asset_path(@media_asset), method: :patch,
              title: "Hide this asset from pickers and search. It can be restored later.",
              class: "inline-flex items-center px-3 py-1.5 border border-border bg-surface text-body text-base font-medium rounded-lg hover:bg-surface-subtle transition-colors cursor-pointer" %>
      <% end %>
      <%= ui_button "Edit", href: edit_media_asset_path(@media_asset), variant: :primary %>
    <% end %>
  <% end %>

  <%= ui_card body: false do %>
    <%# Main info section %>
    <div class="p-6">
      <%# Badges row %>
      <div class="flex flex-wrap gap-2 mb-6">
        <%= ui_badge @media_asset.media_type.to_s.capitalize, variant: type_variants.fetch(@media_asset.media_type, :secondary), pill: true, class: "text-sm" %>
        <%= render StatusBadgeComponent.new(status: @media_asset.status, kind: :media, class: "text-sm") %>
        <%= render "media_assets/availability_badge", availability: @media_asset.availability(reserved_ids: @reserved_ids), size: :large %>
      </div>

      <% if @media_asset.archived? %>
        <p class="mb-6 px-4 py-3 rounded-lg bg-surface-subtle border border-border text-sm text-body-muted">
          Archived <%= @media_asset.archived_at.strftime("%B %-d, %Y") %>. It is hidden from the post editor's picker and the agent's search until restored.
        </p>
      <% end %>

      <%# Media Preview %>
      <% if @media_asset.public_url? %>
        <div class="mb-6">
          <h2 class="text-sm font-medium text-body-muted mb-2">Preview</h2>
          <div class="rounded-lg overflow-hidden bg-surface-subtle w-full sm:max-w-md">
            <% if @media_asset.image? %>
              <%= image_tag @media_asset.public_url,
                  class: "w-full h-auto object-contain",
                  alt: decode_name(@media_asset.external_name.presence || "Media asset") %>
            <% elsif @media_asset.video? %>
              <video
                controls
                class="w-full h-auto"
                preload="metadata"
              >
                <source src="<%= @media_asset.public_url %>" type="<%= @media_asset.mime_type || 'video/mp4' %>">
                Your browser does not support the video tag.
              </video>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Location / GPS %>
      <% if @media_asset.geocoded? %>
        <div class="mb-6">
          <h2 class="text-sm font-medium text-body-muted mb-2">Location</h2>
          <% if @media_asset.address.present? %>
            <p class="text-sm text-body mb-3"><%= @media_asset.address %></p>
          <% end %>
          <div class="rounded-lg overflow-hidden border border-border">
            <iframe src="<%= osm_embed_url(@media_asset.latitude, @media_asset.longitude) %>"
                    title="Map of <%= @media_asset.address.presence || "asset location" %>"
                    class="w-full h-64 border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
          <p class="mt-2 text-xs text-body-muted">
            <span class="font-mono"><%= @media_asset.latitude %>, <%= @media_asset.longitude %></span>
            ·
            <%= link_to "View larger map", osm_link_url(@media_asset.latitude, @media_asset.longitude),
                  target: "_blank", rel: "noopener", class: "text-primary hover:underline" %>
          </p>
        </div>
      <% end %>

      <%# Planned posts count %>
      <%= ui_stat label: "Planned posts", value: @posts_using.size, class: "mb-6 sm:max-w-xs" %>

      <%# Main metadata %>
      <%= ui_description_list layout: :inline do |dl| %>
        <% if @media_asset.width.present? && @media_asset.height.present? %>
          <% dl.with_item(term: "Dimensions", description: "#{@media_asset.width} × #{@media_asset.height}") %>
        <% end %>
        <% if @media_asset.media_type == "video" && @media_asset.duration_seconds.present? %>
          <%
            mins = (@media_asset.duration_seconds / 60).floor
            secs = (@media_asset.duration_seconds % 60).round
          %>
          <% dl.with_item(term: "Duration", description: (mins > 0 ? "#{mins}m #{secs}s" : "#{secs}s")) %>
        <% end %>
        <% if @media_asset.file_size.present? %>
          <% dl.with_item(term: "File Size", description: number_to_human_size(@media_asset.file_size)) %>
        <% end %>
        <% if @media_asset.mime_type.present? %>
          <% dl.with_item(term: "MIME Type", description: @media_asset.mime_type) %>
        <% end %>
        <% dl.with_item(term: "First Seen", description: @media_asset.first_seen_at.strftime("%B %-d, %Y")) %>
        <% if @media_asset.last_processed_at.present? %>
          <% dl.with_item(term: "Last Processed", description: @media_asset.last_processed_at.strftime("%B %-d, %Y")) %>
        <% end %>
        <% dl.with_item(term: "First Published", description: (@media_asset.published? ? @media_asset.published_at.strftime("%B %-d, %Y") : "Never")) %>
        <% dl.with_item(term: "Added", description: @media_asset.created_at.strftime("%B %-d, %Y")) %>
      <% end %>
    </div>

    <%# Posts that use this asset, including as a carousel member %>
    <% if @posts_using.any? %>
      <div class="border-t border-border px-6 py-4">
        <h2 class="text-sm font-medium text-body-muted mb-3">Used in posts</h2>
        <ul class="divide-y divide-border">
          <% @posts_using.each do |post| %>
            <li>
              <%= link_to planned_post_path(post), class: "flex items-center justify-between gap-3 py-2 text-sm hover:bg-surface-subtle -mx-2 px-2 rounded" do %>
                <span class="text-body capitalize truncate">
                  <%= post.platform %> <%= post.post_type unless post.post_type == "single" %> · <%= post.caption.to_s.truncate(60).presence || "No caption" %>
                </span>
                <span class="shrink-0 text-xs text-body-muted">
                  <span class="capitalize"><%= post.status %></span>
                  <% if (when_at = post.published_at || post.scheduled_at) %>
                    · <%= when_at.strftime("%b %-d, %Y") %>
                  <% end %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# Collapsible additional details %>
    <div class="border-t border-border">
      <%= ui_accordion do |accordion| %>
        <% accordion.with_item(title: "Additional Details") do %>
          <%= ui_description_list do |dl| %>
            <% dl.with_item(term: "External ID") do %>
              <span class="font-mono break-all"><%= @media_asset.external_id %></span>
            <% end %>
            <% if @media_asset.raw_metadata.present? %>
              <% metadata = @media_asset.raw_metadata %>
              <% metadata = JSON.parse(metadata) if metadata.is_a?(String) %>
              <% metadata.each do |key, value| %>
                <% dl.with_item(term: key.humanize) do %>
                  <span class="font-mono text-xs break-all"><%= value %></span>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
