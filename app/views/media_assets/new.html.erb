<% content_for :title, "Upload Media" %>

<%= turbo_frame_tag "media-upload-modal" do %>
  <%= form_with url: media_assets_path,
                scope: :media_asset,
                data: { controller: "media-upload",
                        media_upload_direct_upload_url_value: media_assets_direct_uploads_path,
                        action: "submit->media-upload#submit",
                        turbo_frame: "_top" },
                class: "flex flex-col" do |form| %>

    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Upload media</h2>
      <button type="button"
              data-action="click->modal#close"
              class="text-gray-400 hover:text-gray-600 transition-colors leading-none text-2xl"
              aria-label="Close">&times;</button>
    </div>

    <div class="px-6 py-5 flex flex-col gap-5">
      <% if alert.present? %>
        <p class="text-sm text-red-700 bg-red-50 border border-red-200 rounded-md px-3 py-2"><%= alert %></p>
      <% end %>

      <%# Destination folder %>
      <div>
        <%= form.label :folder, "Destination", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :folder,
                        options_for_select(@folders) + options_for_select([ [ "New folder…", "__new__" ] ]),
                        { prompt: "Choose a folder" },
                        required: true,
                        data: { media_upload_target: "folderSelect", action: "change->media-upload#folderChanged" },
                        class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        <%= form.text_field :new_folder,
                            placeholder: "e.g. Gigs/2026 Hook & Ladder",
                            data: { media_upload_target: "newFolderInput" },
                            class: "hidden mt-2 w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        <p class="mt-1 text-xs text-gray-500">Folder in the Spaces bucket the files will be stored under.</p>
      </div>

      <%# Files %>
      <div>
        <%= form.label :files, "Photos & videos", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.file_field :files,
                            multiple: true,
                            accept: "image/*,video/*",
                            required: true,
                            data: { media_upload_target: "fileInput", action: "change->media-upload#filesChanged" },
                            class: "block w-full text-sm text-gray-700 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:text-indigo-700 file:text-sm file:font-medium hover:file:bg-indigo-100 cursor-pointer" %>
        <ul data-media-upload-target="fileList" class="mt-3 flex flex-col gap-2 text-sm empty:hidden"></ul>
      </div>

      <p data-media-upload-target="error" class="hidden text-sm text-red-700 bg-red-50 border border-red-200 rounded-md px-3 py-2"></p>
    </div>

    <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-gray-200 bg-gray-50 rounded-b-xl">
      <button type="button"
              data-action="click->modal#close"
              class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
        Cancel
      </button>
      <%= form.submit "Upload",
                      data: { media_upload_target: "submit" },
                      class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" %>
    </div>
  <% end %>
<% end %>
