<% content_for :title, "Edit Media Asset" %>

<%
  status_options = MediaAsset.statuses.keys.map { |s| [ s.titleize, s ] }
%>

<div class="max-w-2xl mx-auto">
  <%= ui_page_header title: "Edit Media Asset", back: {href: media_asset_path(@media_asset), label: "Media asset"}, class: "mb-6" %>

  <%= ui_form_with model: @media_asset, class: "bg-surface rounded-xl shadow-sm border border-border p-6 space-y-6" do |f| %>
    <%= f.error_summary %>

    <%= f.text_field :external_name, label: "Name", placeholder: "Display name for this asset", hint: "A friendly name to identify this asset." %>

    <%= f.select :status, status_options, {} %>

    <%# Read-only fields for reference %>
    <div class="pt-4 border-t border-border">
      <h2 class="text-sm font-medium text-body-muted mb-1">Reference Information</h2>
      <%= ui_description_list layout: :inline do |dl| %>
        <% dl.with_item(term: "External ID") do %>
          <span class="font-mono break-all"><%= @media_asset.external_id %></span>
        <% end %>
        <% dl.with_item(term: "Media Type") do %>
          <span class="capitalize"><%= @media_asset.media_type %></span>
        <% end %>
      <% end %>
    </div>

    <div class="pt-4 border-t border-border flex items-center justify-end gap-3">
      <%= ui_button "Cancel", href: media_asset_path(@media_asset), variant: :secondary, outline: true %>
      <%= f.submit "Save Changes", variant: :primary %>
    </div>
  <% end %>
</div>
