<% content_for :title, "Sessions" %>

<div class="space-y-6">
  <%= ui_page_header title: "Sessions", subtitle: "#{@sessions.size} record#{"s" if @sessions.size != 1}" %>

  <% if @sessions.empty? %>
    <%= ui_empty_state title: "No sessions found" %>
  <% else %>
    <%= ui_table hover: true, responsive: true do |table| %>
      <% table.with_caption(visible: false) { "Active sessions" } %>
      <thead>
        <tr>
          <%= ui_table_header "User" %>
          <%= ui_table_header "IP address" %>
          <%= ui_table_header "Device" %>
          <%= ui_table_header "Created" %>
          <%= ui_table_header "Last active" %>
        </tr>
      </thead>
      <tbody>
        <% @sessions.each do |session| %>
          <tr>
            <td>
              <div class="flex items-center gap-3">
                <%= ui_avatar name: session.user&.name || "Unknown User", size: :sm %>
                <div class="min-w-0">
                  <p class="font-medium text-body truncate">
                    <%= session.user&.name || "Unknown User" %>
                    <% if session.id == Current.session&.id %>
                      <%= ui_badge "Current", variant: :primary, class: "ml-1" %>
                    <% end %>
                  </p>
                  <p class="text-xs text-body-muted truncate"><%= session.user&.email_address %></p>
                </div>
              </div>
            </td>
            <td class="font-mono text-xs"><%= session.ip_address.presence || "—" %></td>
            <td><span title="<%= session.user_agent %>"><%= device_label(session.user_agent) %></span></td>
            <td class="whitespace-nowrap"><%= session.created_at.strftime("%b %-d, %Y %H:%M") %></td>
            <td class="whitespace-nowrap"><%= session.updated_at.strftime("%b %-d, %Y %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    <% end %>
  <% end %>
</div>
