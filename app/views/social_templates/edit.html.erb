<% content_for :title, "Edit #{@social_template.name}" %>

<%
  platform_options = SocialTemplate.platforms.keys.map { |p| [p.titleize, p] }
%>

<div class="max-w-2xl mx-auto">
  <div class="flex items-start gap-3 mb-6">
    <%# TODO(L4): ui_page_header back: %>
    <%= link_to social_template_path(@social_template), aria: { label: "Back to #{@social_template.name}" }, class: "mt-2 text-body-muted hover:text-body transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    <% end %>
    <%= ui_page_header title: "Edit Social Template", class: "flex-1 min-w-0" %>
  </div>

  <%= ui_card do %>
    <%= ui_form_with model: @social_template, class: "space-y-6" do |f| %>
      <%= f.error_summary title: "#{pluralize(@social_template.errors.count, "error")} prohibited this template from being saved:" %>

      <%= f.text_field :name, placeholder: "Template name" %>
      <%= f.select :platform, platform_options %>
      <%= f.text_area :default_caption, rows: 4, placeholder: "Default caption for posts using this template..." %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <%= f.number_field :max_caption_length, label: "Max Caption Length", placeholder: "e.g. 2200", min: 1, hint: "Maximum characters allowed." %>
        <%= f.text_field :recommended_aspect_ratio, label: "Aspect Ratio", placeholder: "e.g. 4:5 or 1:1", hint: "Recommended aspect ratio." %>
      </div>

      <%# Read-only fields for reference %>
      <div class="pt-4 border-t border-border">
        <%= ui_description_list layout: :inline, class: "text-sm" do |dl| %>
          <% dl.with_item(term: "Owner") { ui_chip(label: @social_template.user&.name || "Global Template", variant: @social_template.user ? :primary : :secondary) } %>
          <% dl.with_item(term: "Posts Using", description: @social_template.planned_posts.size) %>
        <% end %>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-border">
        <%= ui_button "Cancel", href: social_template_path(@social_template), outline: true, variant: :secondary %>
        <%= f.submit "Save Changes", variant: :primary %>
      </div>
    <% end %>
  <% end %>
</div>
