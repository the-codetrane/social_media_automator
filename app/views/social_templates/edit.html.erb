<% content_for :title, "Edit #{@social_template.name}" %>

<%
  platform_options = SocialTemplate.platforms.keys.map { |p| [p.titleize, p] }
%>

<div class="max-w-2xl mx-auto">
  <%# Header with back link %>
  <div class="flex items-center gap-4 mb-6">
    <%= link_to social_template_path(@social_template), class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900">Edit Social Template</h1>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <%= form_with model: @social_template, class: "space-y-6" do |form| %>
      <% if @social_template.errors.any? %>
        <div class="px-4 py-3 rounded-lg bg-red-50 text-red-800 text-sm">
          <p class="font-medium mb-2"><%= pluralize(@social_template.errors.count, "error") %> prohibited this template from being saved:</p>
          <ul class="list-disc list-inside">
            <% @social_template.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :name, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors", placeholder: "Template name" %>
      </div>

      <div>
        <%= form.label :platform, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.select :platform, platform_options, {}, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors bg-white" %>
      </div>

      <div>
        <%= form.label :default_caption, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_area :default_caption, rows: 4, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors resize-none", placeholder: "Default caption for posts using this template..." %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= form.label :max_caption_length, "Max Caption Length", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.number_field :max_caption_length, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors", placeholder: "e.g. 2200", min: 1 %>
          <p class="mt-1 text-xs text-gray-500">Maximum characters allowed.</p>
        </div>
        <div>
          <%= form.label :recommended_aspect_ratio, "Aspect Ratio", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.text_field :recommended_aspect_ratio, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors", placeholder: "e.g. 4:5 or 1:1" %>
          <p class="mt-1 text-xs text-gray-500">Recommended aspect ratio.</p>
        </div>
      </div>

      <%# Read-only fields for reference %>
      <div class="pt-4 border-t border-gray-200">
        <p class="text-xs text-gray-400 uppercase tracking-wide mb-3">Reference Information</p>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-gray-500">Owner</dt>
            <dd class="text-gray-700"><%= @social_template.user&.name || "Global Template" %></dd>
          </div>
          <div>
            <dt class="text-gray-500">Posts Using</dt>
            <dd class="text-gray-700 font-semibold"><%= @social_template.planned_posts.size %></dd>
          </div>
        </dl>
      </div>

      <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-2 sm:gap-3 pt-4 border-t border-gray-200">
        <%= link_to "Cancel", social_template_path(@social_template), class: "w-full sm:w-auto text-center px-4 py-2.5 sm:py-2 text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors border border-gray-300 rounded-lg sm:border-0 sm:rounded-none" %>
        <%= form.submit "Save Changes", class: "w-full sm:w-auto px-4 py-2.5 sm:py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

