<% content_for :title, @social_template.name %>

<div class="max-w-3xl mx-auto">
  <%= ui_page_header title: @social_template.name,
                   back: {href: social_templates_path, label: "Social templates"}, class: "mb-6" do |header| %>
    <% header.with_actions do %>
      <%= ui_button_to social_template_path(@social_template), method: :delete, variant: :danger, outline: true,
                       confirm: "Delete \"#{@social_template.name}\"? This cannot be undone." do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        Delete
      <% end %>
      <%= ui_button href: edit_social_template_path(@social_template), variant: :primary do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Edit
      <% end %>
    <% end %>
  <% end %>

  <%= ui_card body: false do %>
    <div class="p-6">
      <div class="flex flex-wrap gap-2 mb-6">
        <%= render PlatformBadgeComponent.new(platform: @social_template.platform) %>
        <% if @social_template.user.present? %>
          <%= ui_chip label: @social_template.user.name, variant: :primary %>
        <% else %>
          <%= ui_chip label: "Global Template" %>
        <% end %>
      </div>

      <div class="mb-6">
        <p class="text-sm font-medium text-body-muted mb-2">Default Caption</p>
        <% if @social_template.default_caption.present? %>
          <p class="text-body leading-relaxed whitespace-pre-wrap"><%= @social_template.default_caption %></p>
        <% else %>
          <p class="text-body-muted italic">No default caption</p>
        <% end %>
      </div>

      <%= ui_stats columns: 2, label: "Template summary" do |stats| %>
        <% stats.with_stat(label: "Posts Using Template", value: @social_template.planned_posts.size) %>
        <% stats.with_stat(label: "Created", value: @social_template.created_at.strftime("%B %-d, %Y"), class: "[&_dd]:!text-xl") %>
      <% end %>

      <%= ui_detail_list class: "mt-4" do |dl| %>
        <% if @social_template.max_caption_length.present? %>
          <% dl.with_item(term: "Max Caption Length", description: "#{@social_template.max_caption_length} characters") %>
        <% end %>
        <% if @social_template.recommended_aspect_ratio.present? %>
          <% dl.with_item(term: "Recommended Aspect Ratio", description: @social_template.recommended_aspect_ratio) %>
        <% end %>
      <% end %>
    </div>

    <% if @social_template.settings.present? %>
      <div class="border-t border-border px-6 py-2">
        <%= ui_accordion do |accordion| %>
          <% accordion.with_item(title: "Additional Details") do %>
            <p class="text-sm font-medium text-body-muted mb-1">Settings</p>
            <pre class="font-mono text-xs bg-surface-subtle rounded-ui p-4 overflow-x-auto"><%= JSON.pretty_generate(@social_template.settings) %></pre>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
