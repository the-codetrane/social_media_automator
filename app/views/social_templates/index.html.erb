<% content_for :title, "Social Templates" %>

<div class="mb-6">
  <%= ui_page_header title: "Social Templates", subtitle: "#{@social_templates.size} record#{"s" if @social_templates.size != 1}" do |header| %>
    <% header.with_actions do %>
      <%= ui_button href: new_social_template_path, variant: :primary do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        New Template
      <% end %>
    <% end %>
  <% end %>
</div>

<% if @social_templates.empty? %>
  <%= ui_empty_state title: "No social templates found." do |empty| %>
    <% empty.with_action do %>
      <%= ui_button "New Template", href: new_social_template_path, variant: :primary %>
    <% end %>
  <% end %>
<% else %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @social_templates.each do |template| %>
      <%= link_to social_template_path(template), class: "block rounded-ui hover:shadow-md transition-shadow duration-200" do %>
        <%= ui_card class: "h-full" do |card| %>
          <% card.with_header do %>
            <div class="flex items-start justify-between gap-2">
              <p class="font-semibold text-body truncate flex-1"><%= template.name %></p>
              <%= render PlatformBadgeComponent.new(platform: template.platform, class: "shrink-0") %>
            </div>
          <% end %>

          <div class="flex flex-col gap-4">
            <div>
              <% if template.user.present? %>
                <%= ui_chip label: template.user.name, variant: :primary %>
              <% else %>
                <%= ui_chip label: "Global Template" %>
              <% end %>
            </div>

            <% if template.default_caption.present? %>
              <p class="text-sm text-body leading-relaxed line-clamp-3"><%= template.default_caption.truncate(160) %></p>
            <% else %>
              <p class="text-sm text-body-muted italic">No default caption</p>
            <% end %>

            <%= ui_description_list layout: :inline, dividers: false, class: "text-sm" do |dl| %>
              <% if template.max_caption_length.present? %>
                <% dl.with_item(term: "Max Caption", description: "#{template.max_caption_length} chars") %>
              <% end %>
              <% if template.recommended_aspect_ratio.present? %>
                <% dl.with_item(term: "Aspect Ratio", description: template.recommended_aspect_ratio) %>
              <% end %>
              <% dl.with_item(term: "Posts Using", description: template.planned_posts.size) %>
            <% end %>

            <%# A few of the settings as small badges; the full JSON is on the show page %>
            <% setting_labels = template.settings.is_a?(Hash) ? template.settings.filter_map { |key, value|
                 if value == true then key.to_s.humanize
                 elsif value.is_a?(String) && value.present? then value.humanize
                 end
               }.first(3) : [] %>
            <% if setting_labels.any? %>
              <div class="flex flex-wrap gap-1">
                <% setting_labels.each do |setting_label| %>
                  <%= ui_badge setting_label, variant: :secondary, pill: true %>
                <% end %>
              </div>
            <% end %>
          </div>

          <% card.with_footer(class: "text-xs text-body-muted") { "Created #{template.created_at.strftime("%b %-d, %Y")}" } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
