<% content_for :title, "Social Templates" %>

<%
  platform_colors = {
    "instagram" => "bg-pink-100 text-pink-800",
    "youtube"   => "bg-red-100 text-red-700",
    "facebook"  => "bg-blue-100 text-blue-700",
    "tiktok"    => "bg-gray-900 text-white"
  }
%>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Social Templates</h1>
    <p class="text-sm text-gray-500 mt-1"><%= @social_templates.size %> record<%= "s" if @social_templates.size != 1 %></p>
  </div>
  <%= link_to new_social_template_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
    </svg>
    New Template
  <% end %>
</div>

<% if @social_templates.empty? %>
  <div class="text-center py-20 text-gray-400">No social templates found.</div>
<% else %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @social_templates.each do |template| %>
      <%= link_to social_template_path(template), class: "bg-white rounded-xl shadow-sm border border-gray-200 p-5 flex flex-col gap-4 hover:shadow-md hover:border-gray-300 transition-all duration-200 cursor-pointer" do %>

        <%# Header %>
        <div class="flex items-start justify-between gap-2">
          <p class="font-semibold text-gray-900 truncate flex-1"><%= template.name %></p>
          <span class="shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= platform_colors[template.platform] || 'bg-gray-100 text-gray-600' %> capitalize">
            <%= template.platform %>
          </span>
        </div>

        <%# Global / user-owned badge %>
        <div>
          <% if template.user.present? %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700">
              👤 <%= template.user.name %>
            </span>
          <% else %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
              🌐 Global Template
            </span>
          <% end %>
        </div>

        <%# Default caption %>
        <% if template.default_caption.present? %>
          <p class="text-sm text-gray-700 leading-relaxed line-clamp-3">
            <%= template.default_caption.truncate(160) %>
          </p>
        <% else %>
          <p class="text-sm text-gray-400 italic">No default caption</p>
        <% end %>

        <%# Metadata grid %>
        <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
          <% if template.max_caption_length.present? %>
            <div>
              <dt class="text-gray-400 uppercase tracking-wide">Max Caption</dt>
              <dd class="text-gray-700"><%= template.max_caption_length %> chars</dd>
            </div>
          <% end %>
          <% if template.recommended_aspect_ratio.present? %>
            <div>
              <dt class="text-gray-400 uppercase tracking-wide">Aspect Ratio</dt>
              <dd class="text-gray-700"><%= template.recommended_aspect_ratio %></dd>
            </div>
          <% end %>
          <div>
            <dt class="text-gray-400 uppercase tracking-wide">Posts Using</dt>
            <dd class="text-gray-700 font-semibold"><%= template.planned_posts.size %></dd>
          </div>
          <% if template.settings.present? %>
            <div class="col-span-2">
              <dt class="text-gray-400 uppercase tracking-wide">Settings</dt>
              <dd class="text-gray-700 font-mono text-[10px] break-all line-clamp-2">
                <%= template.settings.to_json %>
              </dd>
            </div>
          <% end %>
        </dl>

        <p class="text-xs text-gray-400 border-t border-gray-100 pt-3 mt-auto">
          Created <%= template.created_at.strftime("%b %-d, %Y") %>
        </p>
      <% end %>
    <% end %>
  </div>
<% end %>

