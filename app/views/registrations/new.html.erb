<div class="min-h-screen bg-surface-subtle flex flex-col items-center justify-center py-12 sm:px-6 lg:px-8">
  <div class="mx-auto w-full max-w-md">
    <h1 class="text-center text-3xl font-bold tracking-tight text-body">Create your account</h1>
    <p class="mt-2 text-center text-sm text-body-muted">
      Already have an account?
      <%= link_to "Sign in", new_session_path, class: "font-medium text-primary hover:text-link-hover" %>
    </p>
  </div>

  <div class="mt-8 mx-auto w-full max-w-md">
    <div class="bg-surface py-8 px-4 shadow rounded-lg sm:px-10">

      <%= ui_form_with model: @user, url: registration_path, class: "space-y-6" do |form| %>
        <%= form.error_summary %>
        <%= form.text_field :name, label: "Full name", required: true, autofocus: true,
              autocomplete: "name", placeholder: "Enter your full name" %>
        <%= form.email_field :email_address, label: "Email address", required: true,
              autocomplete: "username", placeholder: "Enter your email address" %>
        <%= form.password_field :password, label: "Password", required: true, autocomplete: "new-password",
              placeholder: "Create a password", maxlength: 72 %>
        <%= form.password_field :password_confirmation, label: "Confirm password", required: true,
              autocomplete: "new-password", placeholder: "Confirm your password", maxlength: 72 %>
        <%= form.submit "Create account", class: "w-full" %>
      <% end %>

    </div>
  </div>
</div>

