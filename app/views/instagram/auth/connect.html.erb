<div class="max-w-lg mx-auto mt-16 p-8 border rounded-xl shadow-sm text-center">
  <img src="https://upload.wikimedia.org/wikipedia/commons/a/a5/Instagram_icon.png"
       alt="Instagram logo" class="h-16 w-16 mx-auto mb-4">

  <h1 class="text-2xl font-semibold mb-2">Connect Instagram</h1>
  <p class="text-gray-500 mb-6">
    Link your Instagram Business Account so we can publish posts on your behalf.
  </p>

  <% if Current.user&.instagram_connected? %>
    <p class="text-green-600 font-medium mb-4">
      ✓ Instagram account already connected (ID: <%= Current.user.instagram_user_id %>)
    </p>
    <%= link_to "Reconnect", @auth_url,
          class: "inline-block px-5 py-2 rounded-lg border border-gray-300 text-sm hover:bg-gray-50" %>
  <% else %>
    <%= link_to "Connect Instagram Account", @auth_url,
          class: "inline-block px-6 py-3 rounded-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium hover:opacity-90" %>
  <% end %>
</div>



