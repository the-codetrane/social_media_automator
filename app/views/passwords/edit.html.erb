<div class="min-h-screen bg-surface-subtle flex flex-col items-center justify-center py-12 sm:px-6 lg:px-8">
  <div class="mx-auto w-full max-w-md">
    <h1 class="text-center text-3xl font-bold tracking-tight text-body">Update your password</h1>
  </div>

  <div class="mt-8 mx-auto w-full max-w-md">
    <div class="bg-surface py-8 px-4 shadow rounded-lg sm:px-10">
      <%= ui_form_with url: password_path(params[:token]), method: :put, class: "space-y-6" do |form| %>
        <%= form.password_field :password, label: "New password", required: true, autocomplete: "new-password",
              placeholder: "Enter new password", maxlength: 72 %>
        <%= form.password_field :password_confirmation, label: "Confirm new password", required: true,
              autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72 %>
        <%= form.submit "Save", class: "w-full" %>
      <% end %>
    </div>
  </div>
</div>
